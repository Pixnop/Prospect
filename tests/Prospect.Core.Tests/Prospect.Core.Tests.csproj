<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CA1707 cible l'API publique ; la convention Scenario_Condition_Resultat des noms de
         test est volontaire et largement répandue en xUnit. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    Seuil de couverture appliqué par coverlet.msbuild à chaque `dotnet test` : sous 80 % de
    lignes couvertes sur Prospect.Core, la commande échoue, en local comme en CI.
  -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>opencover,cobertura</CoverletOutputFormat>
    <Threshold>80</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <Include>[Prospect.Core]*</Include>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="coverlet.msbuild" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Échantillons de HTML réel du ModDB, embarqués plutôt que copiés dans du C# : 29 Ko de
       balisage collés dans une chaîne littérale seraient illisibles en revue et impossibles à
       rafraîchir depuis l'API sans réécrire le fichier à la main. -->
  <ItemGroup>
    <EmbeddedResource Include="ModDb\Fixtures\*.html" />
  </ItemGroup>

  <!-- Journal de lancement complet, embarqué pour la même raison : quarante lignes de journal
       dans un littéral C# ne se relisent pas, et ce fichier-là se compare directement à une vraie
       session du jeu (formes relevées sur Vintage Story 1.22.6, contenu synthétique). -->
  <ItemGroup>
    <EmbeddedResource Include="Diagnostics\Fixtures\*.log" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Prospect.Core\Prospect.Core.csproj" />
  </ItemGroup>

</Project>

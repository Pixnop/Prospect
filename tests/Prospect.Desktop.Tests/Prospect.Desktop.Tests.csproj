<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CA1707 cible l'API publique ; la convention Scenario_Condition_Resultat des noms de
         test est volontaire et largement répandue en xUnit. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Étage « conditions réelles » : l'opt-in et la fabrique de client live sont écrits une seule
       fois, dans Prospect.Core.Tests, et liés ici. Les dupliquer ferait diverger deux copies de la
       seule chose qui garantit qu'aucune requête ne part sans PROSPECT_LIVE=1. -->
  <ItemGroup>
    <Compile Include="..\Prospect.Core.Tests\Live\LiveOptIn.cs" Link="Live\LiveOptIn.cs" />
    <Compile Include="..\Prospect.Core.Tests\Live\LiveModDb.cs" Link="Live\LiveModDb.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Prospect.Desktop\Prospect.Desktop.csproj" />
  </ItemGroup>

</Project>

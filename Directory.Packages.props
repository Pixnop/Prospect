<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Headless" Version="11.3.20" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.3.20" />

    <!-- Tests -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NSubstitute" Version="6.1.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />

    <!-- Décodage LZMA1/LZMA2 des installeurs Inno Setup (GameVersions/Inno). Licence MIT,
         100 % managé : aucun binaire natif n'entre dans la distribution. -->
    <PackageVersion Include="SharpCompress" Version="0.50.4" />

    <!-- Système de fichiers abstrait (Storage) -->
    <PackageVersion Include="System.IO.Abstractions" Version="22.2.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.2.0" />

    <!-- Tests de conformité au jeu (tests/Prospect.GameConformance.Tests) : harnais qui boote un
         vrai serveur Vintage Story headless, voir le README du projet. -->
    <PackageVersion Include="Pixnop.Atlas.XUnit" Version="0.11.0" />

    <!-- Composition root et MVVM (Desktop) -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Prospect.Desktop"
             x:Class="Prospect.Desktop.App">
             <!-- RequestedThemeVariant n'est plus fixé ici : Initialize() (App.axaml.cs) pose une
                  valeur de démarrage sûre (Sombre, l'ancien défaut codé en dur), immédiatement
                  remplacée par ThemeService.ApplyStartupTheme() une fois le réglage persisté lu
                  (OnFrameworkInitializationCompleted). Voir la docstring de ThemeService. -->

    <Application.DataTemplates>
        <!-- Résout n'importe quel ViewModel (page courante du shell, panneau modal, toast...)
             vers sa vue par convention de nom : voir ViewLocator.cs. -->
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tokens d'abord : les ControlThemes qui suivent les consomment en
                     DynamicResource. -->
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Tokens/Colors.axaml" />
                <!-- Le verre vient juste après les couleurs : ses vitres sont des alias de
                     surface au même titre que bg-*, mais avec un alpha (voir Glass.axaml). -->
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Tokens/Glass.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Tokens/Spacing.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Tokens/Radii.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Tokens/Elevation.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Tokens/Motion.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Tokens/Typography.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Icons.axaml" />

                <!-- Les textes UI ne sont PAS inclus ici : le dictionnaire dépend de la langue
                     réglée, donc Initialize() (App.axaml.cs) fusionne le français comme valeur de
                     démarrage sûre, immédiatement remplacé par LanguageService.ApplyStartupLanguage()
                     une fois le réglage persisté lu. Voir Resources/Strings.fr.axaml. -->

                <!-- Contrôles ensuite : leurs ControlThemes consomment les tokens ci-dessus. -->
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Controls/Button.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Controls/TextBox.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Controls/CheckBox.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Controls/RadioButton.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Controls/ToggleSwitch.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Controls/ProgressBar.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Controls/ComboBox.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Controls/ScrollBar.axaml" />
                <ResourceInclude Source="avares://Prospect.Desktop/Styles/Controls/ToolTip.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Badge/Tag/Card/NavItem/MenuFlyout stylent des contrôles nus (ContentControl, Border,
             Button, MenuItem) via classes plutôt qu'un ControlTheme dédié : ce sont des Style par
             sélecteur, pas des ressources nommées, donc ils vivent dans Application.Styles et non
             dans Application.Resources. -->
        <StyleInclude Source="avares://Prospect.Desktop/Styles/Controls/GlassSurface.axaml" />
        <StyleInclude Source="avares://Prospect.Desktop/Styles/Controls/Badge.axaml" />
        <StyleInclude Source="avares://Prospect.Desktop/Styles/Controls/Card.axaml" />
        <StyleInclude Source="avares://Prospect.Desktop/Styles/Controls/NavItem.axaml" />
        <StyleInclude Source="avares://Prospect.Desktop/Styles/Controls/MenuFlyout.axaml" />
        <StyleInclude Source="avares://Prospect.Desktop/Styles/Controls/Tabs.axaml" />
        <StyleInclude Source="avares://Prospect.Desktop/Styles/Controls/Alert.axaml" />
        <StyleInclude Source="avares://Prospect.Desktop/Styles/Controls/RichText.axaml" />
    </Application.Styles>
</Application>
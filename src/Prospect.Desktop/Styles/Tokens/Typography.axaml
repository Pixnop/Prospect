<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Port 1:1 de design/tokens/typography.css et fonts.css.

    Tailles et graisses sont directement utilisables (FontSize et FontWeight sont, comme
    en CSS, des grandeurs absolues). Les interlignes (lh-*) et le suivi de lettres (ls-*)
    du CSS sont en revanche des multiplicateurs sans unité relatifs à la taille de police
    (ex. lh-body:1.55 = 1.55 fois fs-body) : Avalonia exprime LineHeight et LetterSpacing
    en pixels absolus, pas en ratio. Les deux tokens sont portés tels quels (mêmes
    nombres que le CSS) pour rester la spec de référence ; c'est aux styles de texte qui
    les consommeront (hors périmètre de cette PR, qui ne fournit que les tokens) de
    multiplier par la taille de police au point d'usage.

    Les trois familles pointent vers les fichiers embarqués dans Assets/Fonts/ (voir ce
    dossier pour la provenance et les licences OFL) avec les mêmes replis que le CSS.
  -->

  <FontFamily x:Key="FontSans">avares://Prospect.Desktop/Assets/Fonts#IBM Plex Sans, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="FontMono">avares://Prospect.Desktop/Assets/Fonts#IBM Plex Mono, Cascadia Mono, monospace</FontFamily>
  <FontFamily x:Key="FontDisplay">avares://Prospect.Desktop/Assets/Fonts#Space Grotesk, IBM Plex Sans, sans-serif</FontFamily>

  <FontWeight x:Key="FwRegular">Normal</FontWeight>
  <FontWeight x:Key="FwMedium">Medium</FontWeight>
  <FontWeight x:Key="FwSemibold">SemiBold</FontWeight>
  <FontWeight x:Key="FwBold">Bold</FontWeight>

  <!-- Échelle — densité launcher, échelle UI 1.0 -->
  <x:Double x:Key="FsDisplay">32</x:Double>
  <x:Double x:Key="LhDisplay">1.15</x:Double>
  <x:Double x:Key="FsTitle">24</x:Double>
  <x:Double x:Key="LhTitle">1.2</x:Double>
  <x:Double x:Key="FsHeading">18</x:Double>
  <x:Double x:Key="LhHeading">1.3</x:Double>
  <x:Double x:Key="FsSubheading">15</x:Double>
  <x:Double x:Key="LhSubheading">1.4</x:Double>
  <x:Double x:Key="FsBody">14</x:Double>
  <x:Double x:Key="LhBody">1.55</x:Double>
  <x:Double x:Key="FsBodySm">13</x:Double>
  <x:Double x:Key="LhBodySm">1.5</x:Double>
  <x:Double x:Key="FsCaption">12</x:Double>
  <x:Double x:Key="LhCaption">1.45</x:Double>
  <x:Double x:Key="FsMicro">11</x:Double>
  <x:Double x:Key="LhMicro">1.4</x:Double>
  <x:Double x:Key="FsOverline">11</x:Double>

  <x:Double x:Key="LsDisplay">-0.02</x:Double>
  <x:Double x:Key="LsTitle">-0.01</x:Double>
  <x:Double x:Key="LsBody">0</x:Double>
  <x:Double x:Key="LsOverline">0.1</x:Double>

</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Port de .pr-check / .pr-check__box (components/components.css). La coche réutilise
       la géométrie Icon.check plutôt qu'un tracé dédié, cohérent avec l'idée que la
       couleur (et ici le tracé) d'une icône est toujours celle du composant qui l'utilise. -->

  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
    <Setter Property="FontSize" Value="{StaticResource FsBodySm}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate TargetType="CheckBox">
        <Grid ColumnDefinitions="Auto,*">
          <Border Name="PART_Box"
                  Grid.Column="0"
                  Width="16" Height="16"
                  VerticalAlignment="Center"
                  Background="{DynamicResource BgInput}"
                  BorderBrush="{DynamicResource BorderStrong}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusXs}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="{StaticResource DurInstant}" Easing="{StaticResource EaseStandard}" />
                <BrushTransition Property="BorderBrush" Duration="{StaticResource DurInstant}" Easing="{StaticResource EaseStandard}" />
              </Transitions>
            </Border.Transitions>
            <Panel>
              <Path Name="PART_CheckMark"
                    Data="{StaticResource Icon.check}"
                    Stretch="Uniform" Width="10" Height="10"
                    Stroke="{DynamicResource TextOnAccent}" StrokeThickness="3"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    IsVisible="False" />
              <Rectangle Name="PART_IndeterminateMark"
                         Width="8" Height="2"
                         RadiusX="1" RadiusY="1"
                         Fill="{DynamicResource TextOnAccent}"
                         IsVisible="False" />
            </Panel>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter"
                             Grid.Column="1"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             Content="{TemplateBinding Content}"
                             ContentTemplate="{TemplateBinding ContentTemplate}"
                             IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="^:checked /template/ Path#PART_CheckMark">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="^:indeterminate /template/ Rectangle#PART_IndeterminateMark">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Text4}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource BgSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Port de .pr-btn (components/components.css). Primary est la variante par défaut (pas
    de classe requise) ; secondary, ghost et danger s'activent via Classes="secondary|
    ghost|danger". Tailles via Classes="sm|lg", pleine largeur via Classes="block".

    Les règles génériques (état primary) sont déclarées en premier, les blocs de variante
    ensuite : Avalonia applique les styles dans l'ordre du document, donc chaque variante
    doit être déclarée après les règles génériques pour les recouvrir correctement.
  -->

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
    <Setter Property="FontSize" Value="{StaticResource FsBodySm}" />
    <Setter Property="FontWeight" Value="{StaticResource FwSemibold}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="{StaticResource ControlHMd}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="{StaticResource DurInstant}" Easing="{StaticResource EaseStandard}" />
              <BrushTransition Property="BorderBrush" Duration="{StaticResource DurInstant}" Easing="{StaticResource EaseStandard}" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Name="PART_ContentPresenter"
                             Content="{TemplateBinding Content}"
                             ContentTemplate="{TemplateBinding ContentTemplate}"
                             Padding="{TemplateBinding Padding}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                             RecognizesAccessKey="True"
                             TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- ── Primary (défaut) ────────────────────────────────────────────────────── -->
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource AccentDisabled}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Text4}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Border">
      <Setter Property="BoxShadow" Value="{DynamicResource FocusRing}" />
    </Style>

    <!-- ── Tailles et pleine largeur ───────────────────────────────────────────── -->
    <Style Selector="^.sm">
      <Setter Property="Height" Value="{StaticResource ControlHSm}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
    </Style>
    <Style Selector="^.lg">
      <Setter Property="Height" Value="{StaticResource ControlHLg}" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="FontSize" Value="{StaticResource FsBody}" />
    </Style>
    <Style Selector="^.block">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ── Secondary ───────────────────────────────────────────────────────────── -->
    <Style Selector="^.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    </Style>
    <Style Selector="^.secondary:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="^.secondary:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BgActive}" />
    </Style>
    <Style Selector="^.secondary:disabled /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    </Style>

    <!-- ── Ghost ───────────────────────────────────────────────────────────────── -->
    <Style Selector="^.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    </Style>
    <Style Selector="^.ghost:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>
    <Style Selector="^.ghost:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    </Style>
    <Style Selector="^.ghost:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BgActive}" />
    </Style>
    <Style Selector="^.ghost:disabled /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ── Danger ──────────────────────────────────────────────────────────────── -->
    <Style Selector="^.danger">
      <Setter Property="Background" Value="{DynamicResource Danger}" />
      <Setter Property="Foreground" Value="#FFF3EF" />
    </Style>
    <Style Selector="^.danger:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource DangerHover}" />
    </Style>
    <Style Selector="^.danger:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource DangerPressed}" />
    </Style>
    <Style Selector="^.danger:disabled /template/ Border#PART_Border">
      <Setter Property="Background" Value="#4C2A23" />
    </Style>

    <!-- ── Icon (carré, icône seule — port de .pr-iconbtn, PR 4) ──────────────────── -->
    <!-- Ajoutée ici plutôt que dans un fichier séparé : un ControlTheme est unique par clé de
         ressource ({x:Type Button}), donc une variante de Button doit vivre dans CE fichier pour
         profiter du même gabarit (PART_Border) que primary/secondary/ghost/danger ci-dessus. -->
    <Style Selector="^.icon">
      <Setter Property="Width" Value="{StaticResource ControlHMd}" />
      <Setter Property="Height" Value="{StaticResource ControlHMd}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    </Style>
    <Style Selector="^.icon:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>
    <Style Selector="^.icon:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    </Style>
    <Style Selector="^.icon:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BgActive}" />
    </Style>
    <Style Selector="^.icon:disabled /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.icon:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Text4}" />
    </Style>
    <Style Selector="^.icon.sm">
      <Setter Property="Width" Value="{StaticResource ControlHSm}" />
      <Setter Property="Height" Value="{StaticResource ControlHSm}" />
    </Style>
    <Style Selector="^.icon.lg">
      <Setter Property="Width" Value="{StaticResource ControlHLg}" />
      <Setter Property="Height" Value="{StaticResource ControlHLg}" />
    </Style>
    <Style Selector="^.icon.bordered">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="^.icon.danger:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource DangerQuiet}" />
    </Style>
    <Style Selector="^.icon.danger:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
    </Style>

    <!-- ── Tab (onglets — port de .pr-tab, page de détail d'instance) ─────────────── -->
    <!-- Même raisonnement que .icon ci-dessus : une variante de Button vit ici pour profiter du
         gabarit PART_Border commun. Le soulignement actif n'est pas un élément de gabarit séparé :
         c'est la bordure basse de PART_Border elle-même (2px, transparente au repos, Accent une
         fois .on), ce qui évite de dupliquer le ControlTemplate rien que pour Tabs. -->
    <Style Selector="^.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Text3}" />
      <Setter Property="FontSize" Value="{StaticResource FsBodySm}" />
      <Setter Property="FontWeight" Value="{StaticResource FwRegular}" />
      <Setter Property="Padding" Value="0,8,0,8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="^.tab:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.tab:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    </Style>
    <Style Selector="^.tab:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.tab.on">
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
      <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
    </Style>
    <Style Selector="^.tab.on /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <!-- ── CardHit (surface cliquable sans chrome — carte d'Accueil) ──────────────── -->
    <!-- Aucune couleur/état propre : ce bouton n'existe que pour porter un clic sur la vignette
         et le nom d'une InstanceCard (voir le commentaire d'en-tête d'InstanceCardView.axaml),
         il ne doit jamais avoir l'air d'un bouton.

         Height="NaN" et ClipToBounds="False" annulent explicitement deux valeurs héritées du
         ControlTheme Button générique : Height="{StaticResource ControlHMd}" (32px, pensé pour un
         bouton texte/icône ordinaire) et ClipToBounds=True (par défaut sur tout TemplatedControl).
         Sans ce recouvrement, un cardHit qui enveloppe un contenu plus grand que 32px (vignette +
         nom + dernière session, ~150px) se voit imposer une hauteur de 32px puis rogner tout ce qui
         dépasse : seule la tranche supérieure de la bande d'art survit, nom et dernière session
         disparaissent entièrement, quel que soit le thème (repéré aux captures headless du thème
         clair, mais le rognage touchait tout autant le sombre — invisible faute d'y avoir regardé
         de aussi près). Auto-hauteur restaure le comportement normal d'un Button : il se dimensionne
         sur son contenu comme n'importe quel autre conteneur. -->
    <Style Selector="^.cardHit">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="^.cardHit:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.cardHit:pressed /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Port de .pr-tooltip__bubble. TooltipBg (Styles/Tokens/Colors.axaml) est la bulle : stone-750
    en sombre, comme le littéral direct de colors.css (pas d'alias sémantique dédié côté CSS),
    plus une variante claire ajoutée ici. Sans elle, le fond restait figé en stone-750 pendant que
    Foreground (Text1, ci-dessous) suivait le thème et passait sombre en clair : texte sombre sur
    bulle sombre, illisible — le bug le plus sévère trouvé au balayage qui a suivi la QA visuelle
    du thème clair, avant même les pastilles neutres.
  -->

  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource TooltipBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}" />
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontSans}" />
    <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ToolTip">
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource Elev2}">
          <ContentPresenter Padding="{TemplateBinding Padding}"
                             Content="{TemplateBinding Content}"
                             ContentTemplate="{TemplateBinding ContentTemplate}"
                             TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>

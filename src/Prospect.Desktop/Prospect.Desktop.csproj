<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icône de l'exécutable Windows (barre des tâches, explorateur, raccourcis) ; sans effet
         sur Linux, où l'icône de fenêtre vient de MainWindow.axaml (WindowIcon). -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <!-- Décision d'architecture (docs/architecture.md) : bindings compilés partout. Chaque vue
         doit déclarer x:DataType ; une vue qui l'omet échoue à la compilation plutôt que de
         retomber silencieusement sur une liaison par réflexion. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001 : MainWindow n'a plus de constructeur sans paramètre depuis son passage à
         l'injection de constructeur (ShellViewModel résolu par le conteneur DI, voir
         CompositionRoot). L'avertissement porte sur le chargeur XAML par réflexion utilisé par
         l'aperçu de l'IDE ; l'application ne construit jamais ses fenêtres de cette façon
         (toujours via ServiceProvider.GetRequiredService), la capacité perdue n'est donc jamais
         utilisée. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <!-- Même précédent que Prospect.Core.csproj : quelques classes internes (LaunchErrorPresenter,
       qui traduit une exception de lancement en message présentable) méritent un test direct
       plutôt qu'une couverture seulement indirecte via les ViewModels qui les consomment. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Prospect.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- Polices embarquées et autres assets (logo, géométries) : non couverts par les
       globs implicites de la cible Avalonia, contrairement aux .axaml. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Panneau de diagnostics (F12) : présent uniquement dans les builds Debug. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Diagnostics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prospect.Core\Prospect.Core.csproj" />
  </ItemGroup>
</Project>

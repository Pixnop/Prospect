  <x:String x:Key="Settings_NetworkConcurrencyLabel">Simultaneous downloads</x:String>
  <x:String x:Key="Settings_NetworkConcurrencyHint">Applies to game versions and mods alike.</x:String>

  <!-- Comptes -->
  <x:String x:Key="Settings_AccountsSectionTitle">Vintage Story account</x:String>
  <x:String x:Key="Settings_AccountsIntro">Signing in only matters for multiplayer: your session is written into each instance at launch, and the game authenticates with it. Downloading and playing solo never needs it.</x:String>
  <x:String x:Key="Settings_AccountsEmailLabel">Account email</x:String>
  <x:String x:Key="Settings_AccountsPasswordLabel">Password</x:String>
  <x:String x:Key="Settings_AccountsPasswordHint">Your password is used to obtain the session, then forgotten: Prospect keeps it nowhere.</x:String>
  <x:String x:Key="Settings_AccountsSignIn">Sign in</x:String>
  <x:String x:Key="Settings_AccountsSigningIn">Signing in…</x:String>
  <x:String x:Key="Settings_AccountsTwoFactorTitle">Verification code</x:String>
  <x:String x:Key="Settings_AccountsTwoFactorLabel">Six-digit code</x:String>
  <x:String x:Key="Settings_AccountsTwoFactorHint">Your account asks for two-factor authentication. Open your authenticator app and type in the code it shows.</x:String>
  <x:String x:Key="Settings_AccountsTwoFactorSubmit">Submit the code</x:String>
  <x:String x:Key="Settings_AccountsTwoFactorCancel">Cancel</x:String>
  <x:String x:Key="Settings_AccountsSignedInTitle">Signed in</x:String>
  <x:String x:Key="Settings_AccountsSignedInHint">The multiplayer session is written into each instance the moment you launch the game.</x:String>
  <x:String x:Key="Settings_AccountsSignOut">Sign out</x:String>

  <!-- Déconnexion du compte -->
  <x:String x:Key="Dialog_SignOut_Confirm">Sign out</x:String>

  <!-- À propos -->
  <x:String x:Key="Settings_AboutDescription">An independent launcher for Vintage Story. Isolated instances, several game versions side by side, and a built-in ModDB browser. Not affiliated with Anego Studios.</x:String>

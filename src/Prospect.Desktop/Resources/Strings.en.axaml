<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Dictionnaire centralisé des textes UI STATIQUES, version ANGLAISE. Miroir strict de
    Strings.fr.axaml : mêmes clés, même ordre, mêmes sections. Voir l'en-tête du fichier français
    pour le partage des rôles avec Resources/UiText.cs et le mécanisme de choix au démarrage.

    L'anglais s'écrit comme un ORIGINAL, pas comme un décalque du français : même sobriété, même
    adresse directe au joueur, mais des tournures anglaises. Les noms propres (Prospect, Vintage
    Story, ModDB, Anego Studios), les chemins et les formats techniques ne se traduisent pas.
  -->

  <x:String x:Key="App_Title">Prospect</x:String>


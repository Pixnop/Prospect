<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Modpacks"
             xmlns:modpacks="using:Prospect.Core.Modpacks"
             mc:Ignorable="d" d:DesignWidth="440"
             x:Class="Prospect.Desktop.Views.Modpacks.ExportModpackDialogView"
             x:DataType="vm:ExportModpackDialogViewModel">

  <!-- Deux temps dans le même dialogue (voir ExportModpackDialogViewModel) : le formulaire (forme,
       ModConfig, sélecteur de destination), puis, seulement si des mods ont été laissés de côté,
       la liste avant fermeture. Un export sans rien à signaler se ferme directement avec un toast. -->

  <Border Width="440" MaxHeight="560" CornerRadius="{StaticResource RadiusLg}" ClipToBounds="True"
          Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderDefault}"
          BorderThickness="1" BoxShadow="{DynamicResource Elev3}">
    <DockPanel>
      <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}" Padding="22,18">
        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                   FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                   FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
      </Border>

      <!-- ── Pied : formulaire ────────────────────────────────────────────────────── -->
      <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtle}"
              Background="{DynamicResource BgSurfaceRaised}" IsVisible="{Binding !IsResultPhase}">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="22,16">
          <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Left" Command="{Binding CancelCommand}"
                  Content="{StaticResource Dialog_Cancel}" />
          <Button Grid.Column="2" Command="{Binding ExportCommand}" IsEnabled="{Binding !IsBusy}"
                  Content="{StaticResource Dialog_Export_Confirm}" />
        </Grid>
      </Border>

      <!-- ── Pied : résultat ──────────────────────────────────────────────────────── -->
      <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtle}"
              Background="{DynamicResource BgSurfaceRaised}" IsVisible="{Binding IsResultPhase}">
        <Grid ColumnDefinitions="*,Auto" Margin="22,16">
          <Button Grid.Column="1" Command="{Binding CloseResultCommand}" Content="{StaticResource Dialog_Export_Close}" />
        </Grid>
      </Border>

      <ScrollViewer Padding="22">
        <StackPanel Spacing="16">

          <!-- ── Formulaire ─────────────────────────────────────────────────────── -->
          <StackPanel Spacing="16" IsVisible="{Binding !IsResultPhase}">
            <StackPanel Spacing="8">
              <TextBlock Text="{StaticResource Dialog_Export_FormatLabel}" FontSize="{StaticResource FsCaption}"
                         FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
              <RadioButton GroupName="ExportFormat" Content="{StaticResource Dialog_Export_FormatArchive}"
                           IsChecked="{Binding IsArchive}" Command="{Binding SelectFormatCommand}"
                           CommandParameter="{x:Static modpacks:ModpackExportFormat.Archive}" />
              <RadioButton GroupName="ExportFormat" Content="{StaticResource Dialog_Export_FormatManifestOnly}"
                           IsChecked="{Binding IsManifestOnly}" Command="{Binding SelectFormatCommand}"
                           CommandParameter="{x:Static modpacks:ModpackExportFormat.ManifestOnly}" />
            </StackPanel>

            <CheckBox Content="{StaticResource Dialog_Export_IncludeModConfig}"
                      IsChecked="{Binding IncludeModConfig, Mode=TwoWay}"
                      IsVisible="{Binding ShowModConfigOption}" />

            <Border Classes="alert danger" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" LineHeight="18"
                         FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}" />
            </Border>
          </StackPanel>

          <!-- ── Résultat ───────────────────────────────────────────────────────── -->
          <StackPanel Spacing="12" IsVisible="{Binding IsResultPhase}">
            <Border Classes="alert warning">
              <TextBlock Text="{StaticResource Dialog_Export_SkippedNotice}" TextWrapping="Wrap" LineHeight="18"
                         FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}" />
            </Border>

            <Border Classes="card" Padding="0" ClipToBounds="True">
              <ItemsControl ItemsSource="{Binding SkippedMods}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExportSkippedModRowViewModel">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}" Padding="14,10">
                      <StackPanel>
                        <TextBlock Text="{Binding FileName}" FontFamily="{DynamicResource FontMono}"
                                   TextTrimming="CharacterEllipsis" FontSize="{StaticResource FsBodySm}"
                                   Foreground="{DynamicResource Text1}" />
                        <TextBlock Text="{Binding ReasonText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>

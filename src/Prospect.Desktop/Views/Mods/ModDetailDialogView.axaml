<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Mods"
             xmlns:conv="using:Prospect.Desktop.Converters"
             xmlns:controls="using:Prospect.Desktop.Controls"
             mc:Ignorable="d" d:DesignWidth="720"
             x:Class="Prospect.Desktop.Views.Mods.ModDetailDialogView"
             x:DataType="vm:ModDetailDialogViewModel">

  <!--
    Fiche d'un mod (design/ui_kits/launcher/screen-mods.jsx, ModDetail). La description est RENDUE
    telle que l'auteur l'a publiée : titres, gras, listes imbriquées, code, liens et images, via
    RichTextPresenter (voir Controls/RichTextPresenter.cs). Un seul écart assumé subsiste par
    rapport à la maquette : la galerie de captures d'écran n'est pas téléchargée, la description en
    embarque déjà l'essentiel. Le bouton « Ouvrir sur le ModDB » reste là pour la fiche officielle.
  -->

  <Border Width="720" MaxHeight="640" CornerRadius="{StaticResource RadiusLg}" ClipToBounds="True"
          Background="{DynamicResource GlassMenu}" BorderBrush="{DynamicResource GlassEdge}"
          BorderThickness="1" BoxShadow="{DynamicResource GlassElevMenu}">
    <DockPanel>
      <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GlassEdge}" Padding="22,20">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Grid.Column="0" Width="52" Height="52" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource Stone800}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1"
                  ClipToBounds="True">
            <Panel>
              <!-- Même dispositif que la carte du navigateur : pictogramme générique dans l'arbre,
                   masqué dès que le logo est décodé (IModLogoCache). -->
              <Path Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="{StaticResource Icon.package}" Stroke="{DynamicResource Text4}"
                    StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                    IsVisible="{Binding !Logo.HasBitmap, FallbackValue=True}" />
              <Image Width="52" Height="52" Stretch="UniformToFill" Source="{Binding Logo.Bitmap}"
                     IsVisible="{Binding Logo.HasBitmap, FallbackValue=False}" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource FontDisplay}"
                       FontSize="{StaticResource FsHeading}" FontWeight="{StaticResource FwSemibold}"
                       Foreground="{DynamicResource Text1}" />
            <TextBlock Text="{Binding MetaText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                       FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.download}"
                      Stroke="{DynamicResource TextOnAccent}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                <TextBlock Text="{StaticResource Mods_Install}" />
              </StackPanel>
            </Button>
            <Button Classes="icon bordered" Command="{Binding OpenOnModDbCommand}" ToolTip.Tip="{StaticResource Mods_OpenOnModDb}">
              <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource Icon.external-link}"
                    Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            </Button>
            <Button Classes="icon" Command="{Binding CloseCommand}" ToolTip.Tip="{StaticResource Dialog_Close}">
              <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource Icon.x}"
                    Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Marge portée par le contenu, jamais par le Padding du ScrollViewer : ce dernier
           n'est retiré qu'à l'arrangement, pas à la mesure, donc le contenu est mesuré plus
           large que la place qu'il reçoit et finit par déborder. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="22">
          <TextBlock Text="{StaticResource Mods_OpenFailed}" TextWrapping="Wrap" IsVisible="{Binding OpenFailed}"
                     FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource DangerText}" />

          <!-- La description telle que l'auteur l'a écrite. RichTextPresenter compose l'arbre de
               contrôles depuis les blocs analysés côté Core ; son apparence vit dans
               Styles/Controls/RichText.axaml. -->
          <controls:RichTextPresenter Document="{Binding Description}" IsVisible="{Binding HasDescription}"
                                      ImageMaxWidth="640" ImageMaxHeight="420" />

          <!-- Liens déclarés par l'auteur sur sa fiche, ouverts par le même IExternalUrlOpener que
               la page ModDB : rien n'est jamais navigué à l'intérieur de Prospect. -->
          <StackPanel Spacing="8" IsVisible="{Binding HasLinks}">
            <TextBlock Text="{StaticResource Mods_Detail_Links}" FontSize="{StaticResource FsCaption}"
                       FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
            <ItemsControl ItemsSource="{Binding Links}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModExternalLinkViewModel">
                  <Button Classes="sm secondary" Margin="0,0,8,8" Command="{Binding OpenCommand}"
                          ToolTip.Tip="{Binding Url}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.external-link}"
                            Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                      <TextBlock Text="{Binding Label}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{StaticResource Mods_Detail_SourceNote}" TextWrapping="Wrap" LineHeight="18"
                       FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
            <SelectableTextBlock Text="{Binding PageUrlText}" FontFamily="{DynamicResource FontMono}"
                                 FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding HasReleases}">
            <TextBlock Text="{StaticResource Mods_Detail_Versions}" FontSize="{StaticResource FsCaption}"
                       FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
            <Border Classes="card" Padding="0" ClipToBounds="True">
              <ItemsControl ItemsSource="{Binding Releases}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModReleaseRowViewModel">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GlassEdge}" Padding="16,10">
                      <!-- MinWidth plutôt que Width sur la version : les vraies versions de mods
                           montent à « 1.22.0-pre.10 », plus large que les 76px qui alignaient
                           joliment les versions courtes des doubles. Le badge, lui, ne porte plus
                           que la version de jeu visée : la liste des versions compatibles reste
                           dans sa colonne, tronquée, parce qu'une release réelle en déclare
                           jusqu'à 23. -->
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding VersionText}" MinWidth="76" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsCaption}"
                                   Foreground="{DynamicResource Text1}" />
                        <ContentControl Grid.Column="1" Classes="badge" Content="{Binding BadgeText}" IsVisible="{Binding ShowBadge}"
                                        VerticalAlignment="Center"
                                        Classes.stable="{Binding BadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=stable}"
                                        Classes.incompatible="{Binding BadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=incompatible}" />
                        <TextBlock Grid.Column="2" Text="{Binding GameVersionsText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                        <TextBlock Grid.Column="3" Text="{Binding DateText}" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}"
                                   Foreground="{DynamicResource Text4}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>

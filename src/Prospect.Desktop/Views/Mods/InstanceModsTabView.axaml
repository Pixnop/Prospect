<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Mods"
             mc:Ignorable="d" d:DesignWidth="888"
             x:Class="Prospect.Desktop.Views.Mods.InstanceModsTabView"
             x:DataType="vm:InstanceModsTabViewModel">

  <!--
    Onglet Mods de la page de détail d'instance : port de design/components/launcher/ModRow.jsx
    (icône, nom, auteur, version, toggle, retrait) enrichi des informations que le launcher est seul
    à connaître (provenance, raison de non-identification), et de la détection / application des
    mises à jour ModDB (feature 4b) : bouton « Vérifier les mises à jour » avec horodatage humanisé,
    bandeau « N mises à jour disponibles » avec « Tout mettre à jour » et annulation, badge ochre
    (canal unstable du design) et bouton par ligne.
  -->

  <UserControl.Styles>
    <!-- Équivalent du modificateur « disabled » de pr-modrow, dans le design : une ligne
         désactivée reste lisible mais s'efface, pour qu'un coup d'œil suffise à voir ce que le
         jeu chargera.

         L'opacité était à 0,5, et une opacité de conteneur multiplie l'alpha de TOUT ce qu'il
         porte : les lignes d'auteur et de nom de fichier, déjà à 11 px sur le jeton de texte le
         plus discret, tombaient sous 2:1 de contraste. « S'effacer » ne doit pas vouloir dire
         « devenir illisible » : 0,78 marque encore franchement la ligne éteinte sans emporter son
         texte avec elle. -->
    <Style Selector="Border.modRow.off">
      <Setter Property="Opacity" Value="0.78" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="{Binding SummaryText}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
        <TextBlock Text="{Binding LastCheckedText}" Classes="onGlass" Margin="0,2,0,0"
                   FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />

        <!-- Verdict de la dernière vérification. Sans lui, une vérification qui ne trouve rien à
             proposer laisse l'écran exactement dans l'état où elle l'a trouvé, et un bouton qui ne
             change rien passe pour un bouton cassé. -->
        <TextBlock Text="{Binding CheckVerdictText}" Classes="onGlass" IsVisible="{Binding HasCheckVerdict}" Margin="0,2,0,0"
                   TextWrapping="Wrap" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="ghost sm" Margin="0,0,8,0" Command="{Binding CheckUpdatesCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.download}"
                Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          <TextBlock Text="{StaticResource Mods_Tab_CheckUpdates}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="secondary sm" Margin="0,0,8,0" Command="{Binding RefreshCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.refresh}"
                Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          <TextBlock Text="{StaticResource Mods_Tab_Rescan}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="sm" Command="{Binding BrowseCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.search}"
                Stroke="{DynamicResource TextOnAccent}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          <TextBlock Text="{StaticResource Mods_Tab_Browse}" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Bandeau « N mises à jour disponibles », design/ui_kits/launcher/screen-instance.jsx
         (Alert tone="info" + Bouton "Tout mettre à jour"). -->
    <Border Classes="alert info" IsVisible="{Binding HasAvailableUpdates}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding UpdatesAvailableTitle}" VerticalAlignment="Center"
                   FontSize="{StaticResource FsBodySm}" FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text1}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding UpdateAllProgressText}" Margin="0,4,0,0"
                   IsVisible="{Binding IsUpdatingAll}" FontFamily="{DynamicResource FontMono}"
                   FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="ghost sm" IsVisible="{Binding IsUpdatingAll}" Command="{Binding CancelUpdateAllCommand}"
                  Content="{StaticResource Mods_Tab_CancelUpdateAll}" />
          <Button Classes="secondary sm" IsVisible="{Binding !IsUpdatingAll}" Command="{Binding UpdateAllCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.download}"
                    Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
              <TextBlock Text="{StaticResource Mods_Tab_UpdateAll}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="card" Padding="0" ClipToBounds="True" IsVisible="{Binding HasMods}">
      <ItemsControl ItemsSource="{Binding Mods}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InstalledModRowViewModel">
            <Border Classes="modRow" Classes.off="{Binding !IsEnabled}" Padding="16,12"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GlassEdge}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Même tuile que la carte du navigateur (ModBrowserView), à la taille de la
                     rangée : pictogramme générique toujours présent dans l'arbre, masqué une fois
                     les pixels obtenus. Le logo n'existe que pour un mod installé par Prospect,
                     dont la provenance porte l'identifiant de fiche ; un zip déposé à la main
                     garde le pictogramme, ce que le badge de provenance dit déjà en toutes
                     lettres à droite de la même rangée. -->
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource GlassItem}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1"
                        ClipToBounds="True">
                  <Panel>
                    <Path Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="{StaticResource Icon.package}" Stroke="{DynamicResource Text3}"
                          StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                          IsVisible="{Binding !Thumbnail.HasLogo}" />
                    <Image Width="30" Height="30" Stretch="UniformToFill" Source="{Binding Thumbnail.Bitmap}"
                           IsVisible="{Binding Thumbnail.HasLogo}" />
                  </Panel>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                  <!-- Grid et non StackPanel horizontal, ici comme pour la ligne meta juste en
                       dessous : nom, auteur et nom de fichier viennent du modinfo.json et du zip,
                       trois valeurs qu'aucune longueur ne borne. Dans un StackPanel horizontal,
                       leur TextTrimming ne servait à rien (les enfants y sont mesurés sans
                       contrainte de largeur) et la rangée sortait de la ligne. Le nom prend la
                       colonne * et se tronque (infobulle pour le lire en entier), le badge « non
                       identifié » reste en Auto à côté, sans jamais le pousser hors cadre. -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                               VerticalAlignment="Center" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
                    <ContentControl Grid.Column="1" Classes="badge incompatible" Content="{StaticResource Mods_Row_Unidentified}"
                                    Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsUnidentified}" />
                  </Grid>
                  <!-- Même schéma que ci-dessus : l'auteur est plafonné, le nom de fichier prend
                       le reste, les deux se tronquent et se relisent au survol. -->
                  <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding AuthorText}" TextTrimming="CharacterEllipsis"
                               MaxWidth="160" ToolTip.Tip="{Binding AuthorText}"
                               FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                    <TextBlock Grid.Column="1" Text="·" Margin="6,0" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                    <TextBlock Grid.Column="2" Text="{Binding FileNameText}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding FileNameText}" FontFamily="{DynamicResource FontMono}"
                               FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                  </Grid>
                  <TextBlock Text="{Binding UnidentifiedReason}" Margin="0,2,0,0" TextWrapping="Wrap"
                             IsVisible="{Binding IsUnidentified}"
                             FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource WarningText}" />

                  <!-- Ce que le dernier lancement a écrit sur ce mod, et avec quels autres mods il
                       s'entend (Prospect.Core.Diagnostics.GameLogAnalyzer). Sous le nom plutôt
                       qu'à droite avec les pastilles d'état : ces libellés sont des phrases
                       courtes, pas des mots, et la colonne de droite est déjà pleine de commandes
                       dont la largeur ne doit pas dépendre d'un décompte. Rien ne s'affiche quand
                       le mod n'a rien à signaler, ce qui est le cas ordinaire. -->
                  <WrapPanel Margin="0,4,0,0" ItemSpacing="6" LineSpacing="4">
                    <ContentControl Classes="badge incompatible" Content="{Binding LogErrorsText}"
                                    IsVisible="{Binding HasLogErrors}" ToolTip.Tip="{Binding LogProblemTooltip}" />
                    <ContentControl Classes="badge unstable" Content="{Binding LogWarningsText}"
                                    IsVisible="{Binding HasLogWarnings}" ToolTip.Tip="{Binding LogProblemTooltip}" />
                    <ContentControl Classes="badge" Content="{Binding IntegrationText}"
                                    IsVisible="{Binding HasIntegration}" ToolTip.Tip="{Binding IntegrationTooltip}" />
                  </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <ContentControl Classes="badge" Content="{Binding SideText}" IsVisible="{Binding HasSide}" VerticalAlignment="Center" />
                  <ContentControl Classes="badge accent" Content="{Binding ProvenanceText}" IsVisible="{Binding IsFromModDb}" VerticalAlignment="Center" />
                  <ContentControl Classes="badge" Content="{Binding ProvenanceText}" IsVisible="{Binding !IsFromModDb}" VerticalAlignment="Center" />

                  <!-- État de mise à jour : sobre pour « inconnu du ModDB » (texte secondaire, pas
                       d'alarme), ochre (canal unstable) pour « mise à jour disponible ». Le badge
                       « non identifié » du bloc nom couvre déjà le cas « non identifiable », donc
                       aucun indicateur redondant n'est ajouté ici pour cet état. -->
                  <TextBlock Text="{StaticResource Mods_Row_UnknownToModDb}" VerticalAlignment="Center"
                             IsVisible="{Binding IsUnknownToModDb}"
                             FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                  <ContentControl Classes="badge unstable" Content="{StaticResource Mods_Row_UpdateAvailable}"
                                  IsVisible="{Binding HasUpdateAvailable}" VerticalAlignment="Center" />

                  <!-- Une release plus récente existe sans être déclarée pour cette version du jeu.
                       Badge « incompatible » et pas de bouton : cette mise à jour-là ne se prend pas
                       d'un clic, elle passe par le dialogue d'installation et son avertissement. -->
                  <ContentControl Classes="badge incompatible" Content="{StaticResource Mods_Row_UndeclaredUpdate}"
                                  IsVisible="{Binding HasUndeclaredUpdate}" VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding UndeclaredUpdateText}" />
                  <Button Classes="secondary sm" IsVisible="{Binding HasUpdateAvailable}" Command="{Binding UpdateCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.download}"
                            Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                      <TextBlock Text="{StaticResource Mods_Row_Update}" />
                    </StackPanel>
                  </Button>

                  <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" FontFamily="{DynamicResource FontMono}"
                             FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                  <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                ToolTip.Tip="{StaticResource Mods_Row_Toggle}" />
                  <Button Classes="icon sm danger" Command="{Binding RemoveCommand}" ToolTip.Tip="{StaticResource Mods_Row_Remove}">
                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.trash}"
                          Stroke="{DynamicResource Text3}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Border CornerRadius="{StaticResource RadiusMd}" BorderThickness="1" Background="{DynamicResource GlassPane}"
            BorderBrush="{DynamicResource GlassEdgeStrong}" IsVisible="{Binding !HasMods}">
      <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="32,48" MaxWidth="420">
        <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Data="{StaticResource Icon.package}"
              Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round" />
        <TextBlock Text="{StaticResource Mods_Tab_EmptyTitle}" HorizontalAlignment="Center"
                   FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                   FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
        <TextBlock Text="{StaticResource Mods_Tab_EmptyDescription}" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text3}" LineHeight="20" />
        <Button Classes="sm" HorizontalAlignment="Center" Command="{Binding BrowseCommand}"
                Content="{StaticResource Mods_Tab_Browse}" />
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding ModsDirectoryText}" Classes="onGlass" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource FontMono}"
               FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
  </StackPanel>
</UserControl>

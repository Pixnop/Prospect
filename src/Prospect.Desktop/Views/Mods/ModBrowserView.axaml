<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Mods"
             xmlns:conv="using:Prospect.Desktop.Converters"
             xmlns:layout="using:Prospect.Desktop.Layout"
             mc:Ignorable="d" d:DesignWidth="944" d:DesignHeight="760"
             x:Class="Prospect.Desktop.Views.Mods.ModBrowserView"
             x:DataType="vm:ModBrowserViewModel">

  <!--
    Port de design/ui_kits/launcher/screen-mods.jsx : en-tête avec recherche, sélecteur d'instance
    cible, tri et tags de catégorie, puis la grille de cartes. Le bandeau « ModDB injoignable » et
    son état vide reprennent les textes de la maquette.
  -->

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="28,20,28,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="{StaticResource Mods_Title}" FontFamily="{DynamicResource FontDisplay}"
                     FontSize="{StaticResource FsTitle}" FontWeight="{StaticResource FwSemibold}"
                     Foreground="{DynamicResource Text1}" />
          <TextBlock Text="{Binding SubtitleText}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Center" Command="{Binding RefreshCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.refresh}"
                  Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            <TextBlock Text="{StaticResource Mods_Refresh}" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Barre d'outils en Grid plutôt qu'en StackPanel horizontal : la somme des largeurs fixes
           de la maquette (320 + 230 + 170) dépasse la zone de contenu dès que la fenêtre approche
           son plancher, et un StackPanel horizontal laisse tranquillement sortir son dernier
           enfant. Le champ de recherche prend ici la place restante, plafonné à ses 320px de
           maquette ; les deux sélecteurs gardent leur largeur, qui est celle de leur contenu. -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
        <Grid Grid.Column="0" MaxWidth="320" MinWidth="180" HorizontalAlignment="Left" Margin="0,0,10,0">
          <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="{StaticResource Mods_SearchPlaceholder}" Padding="34,0,32,0" />
          <!-- Loupe et croix d'effacement sont posées DANS le champ (design/components/forms/SearchField) :
               leur recouvrement du TextBox est le dessin lui-même. -->
          <Path Width="14" Height="14" Margin="12,0,0,0" Stretch="Uniform" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Center" Data="{StaticResource Icon.search}"
                layout:LayoutContract.AllowsOverlap="True"
                Stroke="{DynamicResource Text4}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          <Button Classes="icon sm" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center"
                  layout:LayoutContract.AllowsOverlap="True"
                  Command="{Binding ClearSearchCommand}" ToolTip.Tip="{StaticResource Mods_ClearSearch}"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.x}"
                  Stroke="{DynamicResource Text3}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          </Button>
        </Grid>

        <ComboBox Grid.Column="1" Width="230" Margin="0,0,10,0"
                  ItemsSource="{Binding TargetInstances}" SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModTargetInstanceViewModel">
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox Grid.Column="2" Width="170" SelectedIndex="{Binding SortIndex, Mode=TwoWay}">
          <ComboBoxItem Content="{StaticResource Mods_Sort_Downloads}" />
          <ComboBoxItem Content="{StaticResource Mods_Sort_Updated}" />
          <ComboBoxItem Content="{StaticResource Mods_Sort_Trending}" />
          <ComboBoxItem Content="{StaticResource Mods_Sort_Name}" />
        </ComboBox>
      </Grid>

      <ItemsControl ItemsSource="{Binding Tags}" Margin="0,12,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ModTagViewModel">
            <Button Classes="ghost sm" Padding="0" Margin="0,0,7,7" Background="Transparent"
                    Command="{Binding $parent[ItemsControl].((vm:ModBrowserViewModel)DataContext).ToggleTagCommand}"
                    CommandParameter="{Binding}">
              <ContentControl Classes="tag" Content="{Binding Name}" Classes.on="{Binding IsActive}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Voir HomeView pour ces deux réglages : sans eux, la grille de cartes est mesurée plus large
         que la place qu'elle reçoit et ne retourne pas à la ligne au bon moment. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" Margin="28,20,28,28">

        <!-- ── Bandeau hors ligne ────────────────────────────────────────────────── -->
        <Border Classes="alert danger" IsVisible="{Binding IsOffline}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0" Width="16" Height="16" Margin="0,1,12,0" Stretch="Uniform" VerticalAlignment="Top"
                  Data="{StaticResource Icon.alert}" Stroke="{DynamicResource DangerText}"
                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{StaticResource Mods_Offline_Title}" FontWeight="{StaticResource FwSemibold}"
                         FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
              <TextBlock Text="{StaticResource Mods_Offline_Description}" TextWrapping="Wrap" LineHeight="17"
                         FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="sm secondary" VerticalAlignment="Center" Margin="12,0,0,0"
                    Content="{StaticResource Mods_Retry}" Command="{Binding RefreshCommand}" />
          </Grid>
        </Border>

        <Border Classes="alert warning" IsVisible="{Binding CacheWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding CacheWarning}" TextWrapping="Wrap" LineHeight="17"
                     FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}" />
        </Border>

        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoading}" />

        <!-- ── Grille de résultats ───────────────────────────────────────────────── -->
        <ItemsControl ItemsSource="{Binding Results}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModCardViewModel">
              <Border Classes="card interactive" Width="300" Height="204" Margin="0,0,16,16">
                <DockPanel>
                  <!-- Même dispositif que la carte d'instance : un bouton sans chrome couvre la
                       zone d'ouverture de la fiche, la rangée d'actions reste en dehors pour que
                       « Installer » ne soit jamais avalé par le clic d'ouverture. -->
                  <Button DockPanel.Dock="Top" Classes="cardHit" Command="{Binding OpenCommand}">
                    <StackPanel>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource Stone800}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                ClipToBounds="True">
                          <Panel>
                            <!-- Repli générique : toujours dans l'arbre visuel, masqué une fois le logo décodé
                                 (IModLogoCache). Jamais de traitement de couleur sur l'image tierce, voir Image ci-dessous. -->
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="{StaticResource Icon.package}" Stroke="{DynamicResource Text4}"
                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  IsVisible="{Binding !HasLogo}" />
                            <Image Width="40" Height="40" Stretch="UniformToFill" Source="{Binding LogoBitmap}" IsVisible="{Binding HasLogo}" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="{StaticResource FwSemibold}"
                                     FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
                          <TextBlock Text="{Binding AuthorText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                     FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.download}"
                                Stroke="{DynamicResource Text4}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                          <TextBlock Text="{Binding DownloadsText}" FontFamily="{DynamicResource FontMono}"
                                     FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,0" MaxLines="2"
                                 IsVisible="{Binding HasDescription}"
                                 TextTrimming="CharacterEllipsis" LineHeight="19" TextAlignment="Left"
                                 FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text2}" />
                    </StackPanel>
                  </Button>

                  <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,14,0,0">
                    <ContentControl Grid.Column="0" Classes="badge" Content="{Binding CompatibilityText}" IsVisible="{Binding ShowCompatibility}"
                                    Classes.stable="{Binding CompatibilityTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=stable}"
                                    Classes.incompatible="{Binding CompatibilityTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=incompatible}" />
                    <ContentControl Grid.Column="1" Classes="badge" Margin="6,0,0,0" Content="{Binding SideText}" IsVisible="{Binding HasSide}" />
                    <Button Grid.Column="3" Classes="sm secondary" Command="{Binding InstallCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource Icon.download}"
                              Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                        <TextBlock Text="{StaticResource Mods_Install}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── État vide ─────────────────────────────────────────────────────────── -->
        <Border CornerRadius="{StaticResource RadiusMd}" BorderThickness="1" Background="Transparent"
                BorderBrush="{DynamicResource BorderDefault}" IsVisible="{Binding ShowEmptyState}">
          <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="32,48" MaxWidth="420">
            <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Data="{StaticResource Icon.wifi-off}"
                  Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round"
                  IsVisible="{Binding IsOffline}" />
            <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Data="{StaticResource Icon.package}"
                  Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round"
                  IsVisible="{Binding !IsOffline}" />
            <TextBlock Text="{Binding EmptyStateTitle}" HorizontalAlignment="Center"
                       FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                       FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
            <TextBlock Text="{Binding EmptyStateDescription}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text3}" LineHeight="20" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

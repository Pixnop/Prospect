<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Mods"
             xmlns:conv="using:Prospect.Desktop.Converters"
             xmlns:controls="using:Prospect.Desktop.Controls"
             xmlns:layout="using:Prospect.Desktop.Layout"
             mc:Ignorable="d" d:DesignWidth="944" d:DesignHeight="760"
             x:Class="Prospect.Desktop.Views.Mods.ModBrowserView"
             x:DataType="vm:ModBrowserViewModel">

  <!--
    Port de design/ui_kits/launcher/screen-mods.jsx : en-tête avec recherche, sélecteur d'instance
    cible, tri et tags de catégorie, puis la grille de cartes. Le bandeau « ModDB injoignable » et
    son état vide reprennent les textes de la maquette.
  -->

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="28,20,28,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="{StaticResource Mods_Title}" Classes="onGlass" FontFamily="{DynamicResource FontDisplay}"
                     FontSize="{StaticResource FsTitle}" FontWeight="{StaticResource FwSemibold}"
                     Foreground="{DynamicResource Text1}" />
          <TextBlock Text="{Binding SubtitleText}" Classes="onGlass" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Center" Command="{Binding RefreshCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.refresh}"
                  Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            <TextBlock Text="{StaticResource Mods_Refresh}" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Barre d'outils en Grid plutôt qu'en StackPanel horizontal : la somme des largeurs fixes
           de la maquette (320 + 230 + 170) dépasse la zone de contenu dès que la fenêtre approche
           son plancher, et un StackPanel horizontal laisse tranquillement sortir son dernier
           enfant. Le champ de recherche prend ici la place restante, plafonné à ses 320px de
           maquette ; les deux sélecteurs gardent leur largeur, qui est celle de leur contenu. -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
        <Grid Grid.Column="0" MaxWidth="320" MinWidth="180" HorizontalAlignment="Left" Margin="0,0,10,0">
          <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="{StaticResource Mods_SearchPlaceholder}" Padding="34,0,32,0" />
          <!-- Loupe et croix d'effacement sont posées DANS le champ (design/components/forms/SearchField) :
               leur recouvrement du TextBox est le dessin lui-même. -->
          <Path Width="14" Height="14" Margin="12,0,0,0" Stretch="Uniform" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Center" Data="{StaticResource Icon.search}"
                layout:LayoutContract.AllowsOverlap="True"
                Stroke="{DynamicResource Text4}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          <Button Classes="icon sm" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center"
                  layout:LayoutContract.AllowsOverlap="True"
                  Command="{Binding ClearSearchCommand}" ToolTip.Tip="{StaticResource Mods_ClearSearch}"
                  IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.x}"
                  Stroke="{DynamicResource Text3}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          </Button>
        </Grid>

        <ComboBox Grid.Column="1" Width="230" Margin="0,0,10,0"
                  ItemsSource="{Binding TargetInstances}" SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModTargetInstanceViewModel">
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox Grid.Column="2" Width="170" SelectedIndex="{Binding SortIndex, Mode=TwoWay}">
          <ComboBoxItem Content="{StaticResource Mods_Sort_Downloads}" />
          <ComboBoxItem Content="{StaticResource Mods_Sort_Updated}" />
          <ComboBoxItem Content="{StaticResource Mods_Sort_Trending}" />
          <ComboBoxItem Content="{StaticResource Mods_Sort_Name}" />
        </ComboBox>
      </Grid>

      <!-- Rangée de catégories sur UNE ligne, défilante horizontalement.
           La maquette (design/ui_kits/launcher/screen-mods.jsx) pose sept catégories choisies à la
           main dans un conteneur `flexWrap`, ce qui tient sur une ligne à sept. Le vrai
           /api/tags en compte 223 : le même WrapPanel occupait alors la moitié de la hauteur de
           page et repoussait la grille hors de l'écran. Une seule ligne, défilante, garde
           l'apparence de la maquette et laisse toutes les catégories atteignables ; les plus
           utiles sont en tête parce que le ViewModel les classe par nombre de mods réellement
           étiquetés (voir ModBrowserViewModel.OrderByUsefulness). Le comportement de filtre, lui,
           ne change pas. -->
      <!--
        Deux corrections tenues ensemble, parce qu'elles répondent au même défaut : une rangée qui
        défile sans qu'on puisse la défiler.

        `flush` retire la gouttière de 12 points (Styles/Controls/ScrollViewer.axaml) et `Padding`
        RÉSERVE la bande de la barre sous le contenu. Sans ça, la barre se peignait PAR-DESSUS les
        pastilles : dans le gabarit Fluent, les barres flottent au-dessus du présentateur, et la
        gouttière ne fait que les décaler vers le haut, c'est-à-dire plus loin dans le contenu. La
        gouttière existe pour les barres collées au bord de la fenêtre, où le cadre vole la poignée ;
        celle-ci est au milieu de la page, donc elle n'en a pas besoin — et c'est exactement le cas
        que la classe `flush` documente.

        `WheelScroll.Horizontal` traduit la molette en défilement latéral. Une souris n'a qu'une
        molette, verticale, et un ScrollViewer sans défilement vertical n'en faisait rien : les deux
        cents catégories au-delà du premier écran n'étaient atteignables qu'en attrapant la barre.
      -->
      <ScrollViewer Margin="0,12,0,0" Classes="flush"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                    controls:WheelScroll.Horizontal="True"
                    ToolTip.Tip="{StaticResource Mods_Tags_ScrollHint}">
        <!--
          La bande de la barre est réservée ICI, par une marge basse du CONTENU, et non par un
          Padding sur le ScrollViewer : son gabarit Fluent ne transmet pas le Padding à son
          présentateur, donc l'écrire là n'aurait rien décalé du tout (mesuré). Ancré en haut pour
          que la marge s'ajoute bien SOUS les pastilles au lieu de se répartir autour d'elles.
        -->
        <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Top" Margin="0,0,0,14">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModTagViewModel">
              <Button Classes="ghost sm" Padding="0" Margin="0,0,7,4" Background="Transparent"
                      Command="{Binding $parent[ItemsControl].((vm:ModBrowserViewModel)DataContext).ToggleTagCommand}"
                      CommandParameter="{Binding}">
                <ContentControl Classes="tag" Content="{Binding Name}" Classes.on="{Binding IsActive}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>

    <!-- Voir HomeView pour ces deux réglages : sans eux, la grille de cartes est mesurée plus large
         que la place qu'elle reçoit et ne retourne pas à la ligne au bon moment.
         ScrollChanged étend la fenêtre de rendu à l'approche du bas (voir le code-behind). -->
    <ScrollViewer x:Name="ResultsScroll" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnResultsScrollChanged">
      <StackPanel Spacing="16" Margin="28,20,28,28">

        <!-- ── Bandeau hors ligne ────────────────────────────────────────────────── -->
        <Border Classes="alert danger" IsVisible="{Binding IsOffline}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0" Width="16" Height="16" Margin="0,1,12,0" Stretch="Uniform" VerticalAlignment="Top"
                  Data="{StaticResource Icon.alert}" Stroke="{DynamicResource DangerText}"
                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{StaticResource Mods_Offline_Title}" FontWeight="{StaticResource FwSemibold}"
                         FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
              <TextBlock Text="{StaticResource Mods_Offline_Description}" TextWrapping="Wrap" LineHeight="17"
                         FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="sm secondary" VerticalAlignment="Center" Margin="12,0,0,0"
                    Content="{StaticResource Mods_Retry}" Command="{Binding RefreshCommand}" />
          </Grid>
        </Border>

        <Border Classes="alert warning" IsVisible="{Binding CacheWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding CacheWarning}" TextWrapping="Wrap" LineHeight="17"
                     FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}" />
        </Border>

        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoading}" />

        <!-- ── Grille de résultats ───────────────────────────────────────────────────
             Grille FLUIDE : FluidGridPanel décide du nombre de colonnes depuis la largeur qu'il
             reçoit et étire ses colonnes pour la remplir (voir Layout/FluidGridPanel.cs, qui dit
             pourquoi aucun panneau fourni ne convenait). Aux trois tailles de la garde, la zone
             de contenu vaut 688, 828 et 1008 points, soit deux, deux et trois colonnes.

             Les cartes n'ont plus ni largeur ni HAUTEUR fixes. Les 204 px imposés jusqu'ici
             dépassaient d'une bonne cinquantaine ce que leur contenu demande : le pied flottait
             au milieu et laissait un gouffre sous la description. La carte se dimensionne
             maintenant sur son contenu, le pied est ancré en bas par le DockPanel, et c'est le
             panneau qui aligne les cartes d'une même rangée sur la plus haute. -->
        <ItemsControl ItemsSource="{Binding Results}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <layout:FluidGridPanel MinItemWidth="320" ColumnSpacing="16" RowSpacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModCardViewModel">
              <Border Classes="card interactive" Padding="14,13">
                <DockPanel>
                  <!-- Même dispositif que la carte d'instance : un bouton sans chrome couvre la
                       zone d'ouverture de la fiche, la rangée d'actions reste en dehors pour que
                       « Installer » ne soit jamais avalé par le clic d'ouverture. -->
                  <!-- La rangée de badges défile horizontalement plutôt que de pousser le bouton
                       hors de la carte : compatibilité, côté et « Installé · 1.2.0 » peuvent
                       coexister sur une carte étroite avec un nom long.

                       L'ORDRE est donc une décision, pas une mise en page : la rangée n'a de place
                       visible que pour deux pastilles (une carte de la grille fluide donne entre
                       200 et 300 points au défileur, les trois en demandent 330), et son défilement
                       n'affiche aucune barre. Ce qui est en dernier n'est jamais vu. « Installé »
                       passe donc en tête — c'est le fait que l'utilisateur venait chercher, celui
                       qui explique que le bouton dise « Gérer » — et c'est le côté client/serveur
                       qui sort du champ sur une carte déjà installée, là où l'onglet Mods de
                       l'instance le donne de toute façon. -->
                  <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                    <ScrollViewer Grid.Column="0" Classes="flush" VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Hidden" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <!-- Ce que l'instance ciblée contient déjà. Ton accent plutôt que stable :
                             ce n'est pas un verdict de compatibilité, c'est un fait. -->
                        <ContentControl Classes="badge accent" Content="{Binding InstalledText}" IsVisible="{Binding IsInstalled}"
                                        VerticalAlignment="Center" />
                        <ContentControl Classes="badge" Content="{Binding CompatibilityText}" IsVisible="{Binding ShowCompatibility}"
                                        VerticalAlignment="Center"
                                        Classes.stable="{Binding CompatibilityTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=stable}"
                                        Classes.incompatible="{Binding CompatibilityTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=incompatible}" />
                        <ContentControl Classes="badge" Content="{Binding SideText}" IsVisible="{Binding HasSide}"
                                        VerticalAlignment="Center" />
                      </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Column="1" Classes="sm secondary" Margin="8,0,0,0" Command="{Binding InstallCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource Icon.download}"
                              Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                              IsVisible="{Binding !IsInstalled}" />
                        <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource Icon.settings}"
                              Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                              IsVisible="{Binding IsInstalled}" />
                        <TextBlock Text="{Binding ActionLabel}" />
                      </StackPanel>
                    </Button>
                  </Grid>

                  <Button Classes="cardHit" VerticalAlignment="Top" Command="{Binding OpenCommand}">
                    <StackPanel>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource Stone800}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1"
                                ClipToBounds="True">
                          <Panel>
                            <!-- Repli générique : toujours dans l'arbre visuel, masqué une fois le logo décodé
                                 (IModLogoCache). Jamais de traitement de couleur sur l'image tierce, voir Image ci-dessous. -->
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="{StaticResource Icon.package}" Stroke="{DynamicResource Text4}"
                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                  IsVisible="{Binding !HasLogo}" />
                            <Image Width="40" Height="40" Stretch="UniformToFill" Source="{Binding LogoBitmap}" IsVisible="{Binding HasLogo}" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="{StaticResource FwSemibold}"
                                     FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
                          <TextBlock Text="{Binding AuthorText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                     FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.download}"
                                Stroke="{DynamicResource Text4}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                          <TextBlock Text="{Binding DownloadsText}" FontFamily="{DynamicResource FontMono}"
                                     FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                        </StackPanel>
                      </Grid>
                      <!-- Description bornée à deux lignes ET tronquée : sans MaxLines, une notice
                           bavarde ferait une carte deux fois plus haute que ses voisines, et le
                           panneau alignerait toute la rangée sur elle. -->
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,10,0,0" MaxLines="2"
                                 IsVisible="{Binding HasDescription}"
                                 TextTrimming="CharacterEllipsis" LineHeight="19" TextAlignment="Left"
                                 FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text2}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── Pied de grille ────────────────────────────────────────────────────────
             La grille ne matérialise qu'une fenêtre de cartes : ce pied dit combien de mods
             correspondent vraiment, et offre l'extension au clavier et à la souris pour qui
             n'utilise pas le défilement. -->
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShownCountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Grid.Column="0" Text="{Binding ShownCountText}" Classes="onGlass" VerticalAlignment="Center"
                     FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}"
                     Foreground="{DynamicResource Text4}" />
          <Button Grid.Column="1" Classes="sm secondary" Content="{StaticResource Mods_ShowMore}"
                  IsVisible="{Binding HasMoreResults}" Command="{Binding ShowMoreCommand}" />
        </Grid>

        <!-- ── État vide ─────────────────────────────────────────────────────────── -->
        <Border CornerRadius="{StaticResource RadiusMd}" BorderThickness="1" Background="{DynamicResource GlassPane}"
                BorderBrush="{DynamicResource GlassEdgeStrong}" IsVisible="{Binding ShowEmptyState}">
          <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="32,48" MaxWidth="420">
            <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Data="{StaticResource Icon.wifi-off}"
                  Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round"
                  IsVisible="{Binding IsOffline}" />
            <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Data="{StaticResource Icon.package}"
                  Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round"
                  IsVisible="{Binding !IsOffline}" />
            <TextBlock Text="{Binding EmptyStateTitle}" HorizontalAlignment="Center"
                       FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                       FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
            <TextBlock Text="{Binding EmptyStateDescription}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text3}" LineHeight="20" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="420"
             x:Class="Prospect.Desktop.Views.Dialogs.DeleteInstanceDialogView"
             x:DataType="vm:DeleteInstanceDialogViewModel">

  <!-- Double confirmation nommant l'instance (voir DeleteInstanceDialogViewModel) : le titre et le
       message nomment l'instance, le bouton dit « Supprimer l'instance », jamais « OK ». -->

  <Border Width="420" CornerRadius="{StaticResource RadiusLg}" ClipToBounds="True"
          Background="{DynamicResource GlassMenu}" BorderBrush="{DynamicResource GlassEdge}"
          BorderThickness="1" BoxShadow="{DynamicResource GlassElevMenu}">
    <StackPanel>
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GlassEdge}" Padding="22,18">
        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                   FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                   FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
      </Border>

      <StackPanel Margin="22" Spacing="12">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="20"
                   FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text2}" />

        <!-- Le dialogue reste vivant pendant la suppression : le travail est déporté hors du thread
             d'interface, donc l'écran continue de se dessiner et peut dire ce qu'il se passe. Pas
             d'annulation offerte : une instance à moitié supprimée est pire que les deux états
             francs (voir InstanceService.DeleteAsync). -->
        <StackPanel Spacing="8" IsVisible="{Binding IsDeleting}">
          <ProgressBar IsIndeterminate="True" HorizontalAlignment="Stretch" />
          <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap"
                     FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" LineHeight="18"
                   FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource DangerText}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlassEdge}" Background="{DynamicResource GlassRowOdd}">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="22,16">
          <Button Grid.Column="0" Classes="ghost" Content="{StaticResource Dialog_Cancel}" Command="{Binding CancelCommand}"
                  HorizontalAlignment="Left" IsEnabled="{Binding !IsDeleting}" />
          <Button Grid.Column="2" Classes="danger" Content="{StaticResource Dialog_Delete_Confirm}"
                  Command="{Binding ConfirmCommand}" IsEnabled="{Binding !IsDeleting}" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Instance"
             xmlns:conv="using:Prospect.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="944" d:DesignHeight="760"
             x:Class="Prospect.Desktop.Views.Instance.InstanceDetailView"
             x:DataType="vm:InstanceDetailViewModel">

  <!--
    Port de design/ui_kits/launcher/screen-instance.jsx : bouton retour, en-tête (vignette, nom,
    version badgée, ligne meta, actions Jouer/Arrêter + Exporter + menu), bandeau d'erreur de
    pré-lancement, onglets. Écart assumé par rapport à la maquette : pas de bouton Dossier dans
    l'en-tête, aucun domaine du Core n'exposant encore d'ouverture de dossier système.
  -->

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="28,20,28,0">
      <Button Classes="ghost sm" Padding="0" Height="22" HorizontalAlignment="Left" Command="{Binding BackCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.chevron-left}"
                Stroke="{DynamicResource Text3}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          <TextBlock Text="{StaticResource Instance_Back}" />
        </StackPanel>
      </Button>

      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
        <Border Grid.Column="0" Width="72" Height="72" CornerRadius="{StaticResource RadiusMd}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="30%,0%" EndPoint="70%,100%">
              <GradientStop Color="{StaticResource Copper900}" Offset="0" />
              <GradientStop Color="{StaticResource Stone850}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="{Binding IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                Stroke="{DynamicResource Text4}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
        </Border>

        <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
          <!-- WrapPanel et non StackPanel horizontal : un StackPanel horizontal mesure ses enfants
               sans contrainte de largeur, donc un nom d'instance long sortait de la colonne et
               allait se peindre par-dessus les boutons d'action. Le WrapPanel, lui, mesure sous la
               largeur disponible : le nom se tronque proprement (infobulle pour le lire en entier)
               et le badge passe à la ligne quand il n'y a plus la place. -->
          <WrapPanel>
            <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsTitle}"
                       FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
            <ContentControl Classes="badge" Content="{Binding VersionText}" VerticalAlignment="Center" Margin="10,0,0,0"
                            Classes.stable="{Binding ChannelBadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=stable}"
                            Classes.unstable="{Binding ChannelBadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=unstable}"
                            Classes.pre="{Binding ChannelBadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=pre}" />
          </WrapPanel>
          <!-- Ligne meta en Grid : le chemin du dataPath est long par nature (racine de données +
               slug), il prend la place restante et se tronque, l'infobulle le rend en entier —
               une valeur machine tronquée doit rester lisible au survol. -->
          <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,6,0,0">
            <TextBlock Grid.Column="0" Text="{Binding PlaytimeText}" FontFamily="{DynamicResource FontMono}"
                       FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
            <TextBlock Grid.Column="1" Text="·" Margin="8,0" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text4}" />
            <TextBlock Grid.Column="2" Text="{Binding PathText}" FontFamily="{DynamicResource FontMono}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding PathText}"
                       FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="lg" IsVisible="{Binding !IsRunning}" Command="{Binding PlayCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.play}"
                    Stroke="{DynamicResource TextOnAccent}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                    IsVisible="{Binding !IsLaunching}" />
              <TextBlock Text="{StaticResource Instance_Play}" IsVisible="{Binding !IsLaunching}" />
              <TextBlock Text="{StaticResource Instance_Launching}" IsVisible="{Binding IsLaunching}" />
            </StackPanel>
          </Button>
          <Button Classes="lg secondary" IsVisible="{Binding IsRunning}" Command="{Binding RequestStopCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.square}"
                    Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
              <TextBlock Text="{StaticResource Instance_Stop}" />
            </StackPanel>
          </Button>
          <Button Classes="lg secondary" Command="{Binding ExportCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.upload}"
                    Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
              <TextBlock Text="{StaticResource Instance_Export}" />
            </StackPanel>
          </Button>
          <Button Classes="icon lg bordered" ToolTip.Tip="{StaticResource Instance_MoreActions}">
            <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource Icon.more}"
                  Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            <Button.Flyout>
              <MenuFlyout Placement="Bottom">
                <MenuItem Header="{StaticResource Instance_CheckInstance}" Command="{Binding CheckInstanceCommand}" />
                <MenuItem Header="{StaticResource Instance_Rename}" Command="{Binding RenameCommand}" />
                <MenuItem Header="{StaticResource Instance_Duplicate}" Command="{Binding DuplicateCommand}" />
                <MenuItem Header="{StaticResource Instance_Delete}" Command="{Binding DeleteCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Sauvegarde automatique de pré-lancement (voir InstanceDetailViewModel.PlayAsync et
           GameLauncher.RunAutoBackupBeforeLaunchAsync) : ne s'affiche que le temps de la sauvegarde,
           avant l'injection de session et le démarrage du processus. -->
      <TextBlock Margin="0,10,0,0" Text="{Binding AutoBackupProgressText}" FontFamily="{DynamicResource FontMono}"
                 FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}"
                 IsVisible="{Binding AutoBackupProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border Classes="alert danger" Margin="0,16,0,0" IsVisible="{Binding ShowLaunchError}">
        <Grid ColumnDefinitions="Auto,*">
          <Path Grid.Column="0" Width="16" Height="16" Margin="0,1,12,0" Stretch="Uniform" VerticalAlignment="Top"
                Data="{StaticResource Icon.alert}" Stroke="{DynamicResource DangerText}"
                StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{Binding LaunchErrorTitle}" FontWeight="{StaticResource FwSemibold}"
                       FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
            <TextBlock Text="{Binding LaunchErrorMessage}" TextWrapping="Wrap" LineHeight="17"
                       FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}" />
            <Button Classes="sm secondary" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Content="{StaticResource Instance_InstallAction}" Command="{Binding GoToVersionsCommand}"
                    IsVisible="{Binding ShowInstallAction}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="tabsBar" Margin="0,20,0,0">
        <StackPanel Orientation="Horizontal" Spacing="20">
          <Button Classes="tab" Content="{StaticResource Tab_Mods}" Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static vm:InstanceDetailTab.Mods}"
                  Classes.on="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Mods}" />
          <Button Classes="tab" Content="{StaticResource Tab_Worlds}" Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static vm:InstanceDetailTab.Worlds}"
                  Classes.on="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Worlds}" />
          <Button Classes="tab" Content="{StaticResource Tab_Journal}" Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static vm:InstanceDetailTab.Journal}"
                  Classes.on="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Journal}" />
          <Button Classes="tab" Content="{StaticResource Tab_Options}" Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static vm:InstanceDetailTab.Options}"
                  Classes.on="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Options}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Voir HomeView : marge sur le contenu, jamais Padding sur le ScrollViewer. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28,20,28,28">

        <!-- ── Mods ──────────────────────────────────────────────────────────────── -->
        <ContentControl Content="{Binding ModsTab}"
                        IsVisible="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Mods}" />

        <!-- ── Mondes ────────────────────────────────────────────────────────────── -->
        <StackPanel Spacing="16"
                    IsVisible="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Worlds}">
          <Border Classes="card" ClipToBounds="True" IsVisible="{Binding HasWorlds}">
            <ItemsControl ItemsSource="{Binding Worlds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InstanceWorldRowViewModel">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}" Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Path Grid.Column="0" Width="15" Height="15" Margin="0,0,12,0" Stretch="Uniform"
                            Data="{StaticResource Icon.layers}" Stroke="{DynamicResource Text3}"
                            StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                 FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SizeText}" FontFamily="{DynamicResource FontMono}"
                                   FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                        <TextBlock Text="·" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text4}" />
                        <TextBlock Text="{Binding LastModifiedText}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <Border CornerRadius="{StaticResource RadiusMd}" BorderThickness="1" Background="Transparent"
                  BorderBrush="{DynamicResource BorderDefault}" IsVisible="{Binding !HasWorlds}">
            <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="32,48" MaxWidth="400">
              <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Data="{StaticResource Icon.layers}"
                    Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round" />
              <TextBlock Text="{StaticResource Instance_Worlds_EmptyTitle}" HorizontalAlignment="Center"
                         FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                         FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
              <TextBlock Text="{StaticResource Instance_Worlds_EmptyDescription}" HorizontalAlignment="Center" TextAlignment="Center"
                         TextWrapping="Wrap" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text3}" LineHeight="20" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ── Journal ───────────────────────────────────────────────────────────── -->
        <StackPanel Spacing="12"
                    IsVisible="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Journal}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{StaticResource Instance_Journal_RunningNotice}" VerticalAlignment="Center"
                       FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource WarningText}" IsVisible="{Binding IsRunning}" />
            <Button Grid.Column="1" Classes="secondary sm" Command="{Binding RefreshJournalCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.refresh}"
                      Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                <TextBlock Text="{StaticResource Instance_Journal_Refresh}" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Classes="card" IsVisible="{Binding HasJournalContent}">
            <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled">
              <SelectableTextBlock Text="{Binding JournalContent}" Margin="16" FontFamily="{DynamicResource FontMono}"
                                    FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}"
                                    TextWrapping="Wrap" LineHeight="18" />
            </ScrollViewer>
          </Border>

          <Border CornerRadius="{StaticResource RadiusMd}" BorderThickness="1" Background="Transparent"
                  BorderBrush="{DynamicResource BorderDefault}" IsVisible="{Binding !HasJournalContent}">
            <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="32,48" MaxWidth="400">
              <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Data="{StaticResource Icon.list}"
                    Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round" />
              <TextBlock Text="{StaticResource Instance_Journal_EmptyTitle}" HorizontalAlignment="Center"
                         FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                         FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
              <TextBlock Text="{StaticResource Instance_Journal_EmptyDescription}" HorizontalAlignment="Center" TextAlignment="Center"
                         TextWrapping="Wrap" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text3}" LineHeight="20" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ── Options ───────────────────────────────────────────────────────────── -->
        <StackPanel Spacing="16"
                    IsVisible="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Options}">
          <Border Classes="card">
            <StackPanel Margin="20" Spacing="16" MaxWidth="560" DataContext="{Binding OptionsTab}" x:DataType="vm:InstanceOptionsTabViewModel">
              <StackPanel Spacing="4">
                <TextBlock Text="{StaticResource Instance_Options_Title}" FontSize="{StaticResource FsSubheading}"
                           FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
                <TextBlock Text="{StaticResource Instance_Options_Description}" FontSize="{StaticResource FsBodySm}"
                           Foreground="{DynamicResource Text3}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{StaticResource Instance_Options_ExtraArgsLabel}" FontSize="{StaticResource FsCaption}"
                           FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
                <TextBox Text="{Binding ExtraArgsText, Mode=TwoWay}" AcceptsReturn="True" Height="88"
                          FontFamily="{DynamicResource FontMono}" TextWrapping="NoWrap" />
                <TextBlock Text="{StaticResource Instance_Options_ExtraArgsHint}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{StaticResource Instance_Options_EnvLabel}" FontSize="{StaticResource FsCaption}"
                           FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
                <TextBox Text="{Binding EnvVarsText, Mode=TwoWay}" AcceptsReturn="True" Height="88"
                          FontFamily="{DynamicResource FontMono}" TextWrapping="NoWrap" />
                <TextBlock Text="{StaticResource Instance_Options_EnvHint}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}"
                           IsVisible="{Binding EnvVarsError, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                <TextBlock Text="{Binding EnvVarsError}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource DangerText}"
                           IsVisible="{Binding EnvVarsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <CheckBox Content="{StaticResource Instance_Options_MesaGlThread}" IsChecked="{Binding MesaGlThreadEnabled, Mode=TwoWay}"
                        IsVisible="{Binding ShowMesaGlThreadToggle}" />

              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Text="{StaticResource Instance_Options_ApplyNote}" VerticalAlignment="Center"
                           FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                <Button Grid.Column="1" Content="{StaticResource Instance_Options_Save}" Command="{Binding SaveCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Bloc Sauvegardes (chantier Sauvegardes d'instance) : écart assumé par rapport à la
               maquette, qui n'a pas d'onglet Sauvegardes dédié — Options est la maison des réglages
               d'instance, exactement comme les arguments de lancement juste au-dessus. -->
          <Border Classes="card">
            <StackPanel Margin="20" Spacing="16" MaxWidth="560" DataContext="{Binding OptionsTab.Backups}" x:DataType="vm:InstanceBackupsSectionViewModel">
              <StackPanel Spacing="4">
                <TextBlock Text="{StaticResource Instance_Backups_Title}" FontSize="{StaticResource FsSubheading}"
                           FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
                <TextBlock Text="{StaticResource Instance_Backups_Description}" FontSize="{StaticResource FsBodySm}"
                           Foreground="{DynamicResource Text3}" TextWrapping="Wrap" />
              </StackPanel>

              <CheckBox Content="{StaticResource Instance_Backups_AutoToggle}" IsChecked="{Binding AutoBeforeLaunch, Mode=TwoWay}" />

              <StackPanel Spacing="6">
                <TextBlock Text="{StaticResource Instance_Backups_KeepCountLabel}" FontSize="{StaticResource FsCaption}"
                           FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
                <ComboBox Width="240" HorizontalAlignment="Left"
                          ItemsSource="{Binding AllowedKeepCounts}"
                          SelectedItem="{Binding KeepCount, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                      <TextBlock Text="{Binding Converter={x:Static conv:BackupKeepCountLabelConverter.Instance}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Text="{Binding CreateProgressText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                <Button Grid.Column="1" Content="{StaticResource Instance_Backups_CreateNow}" Command="{Binding CreateNowCommand}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Backups}" IsVisible="{Binding HasBackups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InstanceBackupRowViewModel">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}" Padding="0,12">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DateText}" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
                          <TextBlock Text="{Binding SizeText}" FontFamily="{DynamicResource FontMono}"
                                     FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary sm" Margin="8,0,0,0"
                                Content="{StaticResource Instance_Backups_Restore}" Command="{Binding RestoreCommand}" />
                        <Button Grid.Column="2" Classes="ghost sm" Margin="8,0,0,0"
                                Content="{StaticResource Instance_Backups_Delete}" Command="{Binding DeleteCommand}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="4" IsVisible="{Binding !HasBackups}">
                <TextBlock Text="{StaticResource Instance_Backups_EmptyTitle}"
                           FontWeight="{StaticResource FwMedium}" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text2}" />
                <TextBlock Text="{StaticResource Instance_Backups_EmptyDescription}" TextWrapping="Wrap"
                           FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text4}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>

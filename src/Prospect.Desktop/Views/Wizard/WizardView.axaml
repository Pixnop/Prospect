<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Wizard"
             xmlns:conv="using:Prospect.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="640"
             x:Class="Prospect.Desktop.Views.Wizard.WizardView"
             x:DataType="vm:WizardViewModel">

  <!--
    Port de design/ui_kits/launcher/screen-wizard.jsx. L'étape 2 est le sélecteur de versions de
    la maquette : filtre par canal, liste des versions installées puis téléchargeables, avec la
    taille annoncée par le catalogue. Pas de ligne de connexion entre les pastilles d'étape
    (contrairement à la maquette) : une UniformGrid les espace également, simplification volontaire
    qui garde la lecture de la progression intacte.
  -->

  <UserControl.Styles>
    <Style Selector="Border.step-dot">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    </Style>
    <Style Selector="Border.step-dot.current">
      <Setter Property="Background" Value="{DynamicResource AccentQuiet}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.step-dot.done">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBlock.step-label">
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    </Style>
    <Style Selector="TextBlock.step-label.upcoming">
      <Setter Property="Foreground" Value="{DynamicResource Text4}" />
    </Style>
    <Style Selector="Border.icon-choice">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BgInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    </Style>
    <Style Selector="Border.icon-choice.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource AccentQuiet}" />
    </Style>
    <!-- Hauteur de rangée de liste (44px du design) et non celle d'un bouton ordinaire (32px) :
         avec les 10px de padding vertical de la rangée, un bouton de 32px ne laissait que 10px de
         contenu, où la pastille de canal (20px) ne pouvait que déborder. -->
    <Style Selector="Button.version-choice">
      <Setter Property="Height" Value="{StaticResource RowH}" />
    </Style>
    <Style Selector="Button.version-choice.selected /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource BgSelected}" />
    </Style>
  </UserControl.Styles>

  <Border Width="640" CornerRadius="{StaticResource RadiusLg}" ClipToBounds="True"
          Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderDefault}"
          BorderThickness="1" BoxShadow="{DynamicResource Elev3}">
    <DockPanel>

      <!-- En-tête -->
      <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}">
        <Grid ColumnDefinitions="*,Auto" Margin="22,18">
          <TextBlock Grid.Column="0" Text="{StaticResource Wizard_Title}" VerticalAlignment="Center"
                     FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                     FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
          <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCommand}" ToolTip.Tip="{StaticResource Wizard_Cancel}">
            <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource Icon.x}"
                  Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          </Button>
        </Grid>
      </Border>

      <!-- Bandeau d'étapes -->
      <ItemsControl DockPanel.Dock="Top" Margin="22,16,22,0" ItemsSource="{Binding Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WizardStepIndicatorViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="step-dot" Classes.current="{Binding IsCurrent}" Classes.done="{Binding IsDone}">
                <Panel>
                  <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="{DynamicResource Text4}"
                             IsVisible="{Binding !IsDone}"
                             Classes.current="{Binding IsCurrent}">
                    <TextBlock.Styles>
                      <Style Selector="TextBlock.current">
                        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                      </Style>
                    </TextBlock.Styles>
                  </TextBlock>
                  <Path Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="{StaticResource Icon.check}" Stroke="{DynamicResource TextOnAccent}"
                        StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round" IsVisible="{Binding IsDone}" />
                </Panel>
              </Border>
              <TextBlock Text="{Binding Label}" Classes="step-label" Classes.upcoming="{Binding IsUpcoming}"
                         FontSize="{StaticResource FsCaption}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Pied : navigation -->
      <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtle}"
              Background="{DynamicResource BgSurfaceRaised}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="22,16">
          <Button Grid.Column="0" Classes="ghost" Content="{StaticResource Wizard_Cancel}" Command="{Binding CancelCommand}" />
          <Button Grid.Column="2" Classes="secondary" Content="{StaticResource Wizard_Previous}" Margin="0,0,8,0"
                  Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
          <Button Grid.Column="3" Content="{StaticResource Wizard_Next}" Command="{Binding NextCommand}"
                  IsVisible="{Binding !IsLastStep}" />
          <Button Grid.Column="3" Content="{StaticResource Wizard_Create}" Command="{Binding CreateCommand}"
                  IsVisible="{Binding IsLastStep}" />
        </Grid>
      </Border>

      <!-- Corps : une section par étape -->
      <Panel Margin="22" MinHeight="250">

        <StackPanel IsVisible="{Binding IsNameStep}" Spacing="18">
          <StackPanel Spacing="6">
            <TextBlock Text="{StaticResource Wizard_Step1_NameLabel}" FontSize="{StaticResource FsCaption}"
                       FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
            <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="{StaticResource Wizard_Step1_NamePlaceholder}" />
            <StackPanel Orientation="Horizontal" Spacing="0">
              <TextBlock Text="{StaticResource Wizard_Step1_SlugPrefix}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
              <TextBlock Text="{Binding SlugPreview}" FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
            </StackPanel>
            <TextBlock Text="{Binding NameError}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource DangerText}"
                       IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsVersionStep}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{StaticResource Wizard_Step2_VersionLabel}" VerticalAlignment="Center"
                       FontSize="{StaticResource FsCaption}" FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
            <ComboBox Grid.Column="1" Width="170" SelectedIndex="{Binding ChannelFilterIndex, Mode=TwoWay}">
              <ComboBoxItem Content="{StaticResource Wizard_Step2_ChannelAll}" />
              <ComboBoxItem Content="{StaticResource Wizard_Step2_ChannelStable}" />
              <ComboBoxItem Content="{StaticResource Wizard_Step2_ChannelUnstable}" />
              <ComboBoxItem Content="{StaticResource Wizard_Step2_ChannelPre}" />
            </ComboBox>
          </Grid>

          <TextBlock Text="{StaticResource Wizard_Step2_Loading}" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource Text3}" IsVisible="{Binding IsLoadingVersions}" />

          <TextBlock Text="{Binding VersionsWarning}" FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                     Foreground="{DynamicResource WarningText}"
                     IsVisible="{Binding VersionsWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Border Classes="card" MaxHeight="240" IsVisible="{Binding !!VersionChoices.Count}">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding VersionChoices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GameVersionChoiceViewModel">
                    <Button Classes="ghost version-choice" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="0" Padding="14,10">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <RadioButton Grid.Column="0" IsChecked="{Binding IsSelected, Mode=OneWay}" IsHitTestVisible="False" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
                        <ContentControl Grid.Column="2" Classes="badge" Content="{Binding ChannelBadgeTone}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Classes.stable="{Binding ChannelBadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=stable}"
                                        Classes.unstable="{Binding ChannelBadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=unstable}"
                                        Classes.pre="{Binding ChannelBadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=pre}" />
                        <TextBlock Grid.Column="3" Text="{Binding StateText}" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <TextBlock Text="{StaticResource Wizard_Step2_Empty}" FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Text3}"
                     IsVisible="{Binding !VersionChoices.Count}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsIconStep}" Spacing="14">
          <TextBlock Text="{StaticResource Wizard_Step3_Title}" FontSize="{StaticResource FsBodySm}"
                     FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text1}" />
          <TextBlock Text="{StaticResource Wizard_Step3_Description}" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource Text3}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding IconChoices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IconChoiceOption">
                <Button Classes="ghost" Command="{Binding SelectCommand}" Margin="0,0,10,10" Padding="0" BorderThickness="0" ToolTip.Tip="{Binding Label}">
                  <Border Classes="icon-choice" Classes.selected="{Binding IsSelected}">
                    <Path Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="{Binding IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                          Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsSummaryStep}" Spacing="12">
          <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource Wizard_Step4_Name}" Foreground="{DynamicResource Text3}" FontSize="{StaticResource FsBodySm}" Margin="0,0,0,10" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource Wizard_Step4_Version}" Foreground="{DynamicResource Text3}" FontSize="{StaticResource FsBodySm}" Margin="0,0,0,10" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVersionText}" FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{StaticResource Wizard_Step4_Icon}" Foreground="{DynamicResource Text3}" FontSize="{StaticResource FsBodySm}" Margin="0,0,0,10" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedIconKey}" FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" Margin="0,0,0,10" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{StaticResource Wizard_Step4_Location}" Foreground="{DynamicResource Text3}" FontSize="{StaticResource FsBodySm}" />
            <!-- Grid et non StackPanel horizontal : le slug dérive du nom saisi, donc il est aussi
                 long que l'utilisateur le veut, et un StackPanel horizontal le laissait sortir du
                 panneau. Il prend ici la place restante et se tronque, l'infobulle le rend entier. -->
            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="~/.prospect/instances/" FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
              <TextBlock Grid.Column="1" Text="{Binding SlugPreview}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SlugPreview}"
                         FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
            </Grid>
          </Grid>
          <TextBlock Text="{Binding SummaryNote}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" TextWrapping="Wrap" />
          <TextBlock Text="{StaticResource Wizard_Step4_Note}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" TextWrapping="Wrap" />

          <!-- Installation de la version choisie, avant la création de l'instance. -->
          <StackPanel Spacing="8" IsVisible="{Binding IsInstallingVersion}">
            <ProgressBar Value="{Binding InstallProgressPercent}" Minimum="0" Maximum="100"
                         IsIndeterminate="{Binding IsInstallIndeterminate}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding InstallPhaseText}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text2}" />
              <TextBlock Grid.Column="1" Text="{Binding InstallDetailText}" Margin="8,0,0,0"
                         FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
              <Button Grid.Column="2" Classes="ghost sm" Content="{StaticResource Wizard_CancelInstall}" Command="{Binding CancelInstallCommand}" />
            </Grid>
          </StackPanel>

          <TextBlock Text="{Binding CreateError}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource DangerText}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding CreateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

      </Panel>
    </DockPanel>
  </Border>
</UserControl>

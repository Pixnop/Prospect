<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Common"
             xmlns:conv="using:Prospect.Desktop.Converters"
             mc:Ignorable="d"
             x:Class="Prospect.Desktop.Views.Common.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel">

  <!-- Page « bientôt disponible » sobre (Mods, Versions, Réglages) : le même EmptyState que celui
       de screen-home.jsx, sans action puisqu'il n'y a rien à faire pour l'instant. -->

  <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360">
      <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center"
            Data="{Binding IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
            Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round" />
      <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" TextAlignment="Center"
                 FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                 FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
      <TextBlock Text="{Binding Description}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                 FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text3}" LineHeight="20" />
    </StackPanel>
  </Grid>
</UserControl>

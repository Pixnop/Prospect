<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Settings"
             xmlns:settings="using:Prospect.Core.Settings"
             xmlns:conv="using:Prospect.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="944" d:DesignHeight="760"
             x:Class="Prospect.Desktop.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <!--
    Port de design/ui_kits/launcher/screen-settings.jsx : titre, onglets (même Border
    Classes="tabsBar" + Button Classes="tab" qu'InstanceDetailView), cinq sections. La carte
    d'adoption VS Launcher de la #31 (Général) est reprise telle quelle, sans toucher à ses
    bindings : elle reste liée au SettingsViewModel racine, pas au sous-DataContext General
    utilisé par le thème et la langue juste au-dessus d'elle.
  -->

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="28,24,28,0" Spacing="4">
      <TextBlock Text="{StaticResource Settings_Title}" Classes="onGlass"
                 FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsTitle}"
                 FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />

      <Border Classes="tabsBar" Margin="0,16,0,0">
        <StackPanel Orientation="Horizontal" Spacing="20">
          <Button Classes="tab" Content="{StaticResource Settings_Tab_General}" Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static vm:SettingsTab.General}"
                  Classes.on="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=General}" />
          <Button Classes="tab" Content="{StaticResource Settings_Tab_Game}" Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static vm:SettingsTab.Game}"
                  Classes.on="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Game}" />
          <Button Classes="tab" Content="{StaticResource Settings_Tab_Network}" Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static vm:SettingsTab.Network}"
                  Classes.on="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Network}" />
          <Button Classes="tab" Content="{StaticResource Settings_Tab_Accounts}" Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static vm:SettingsTab.Accounts}"
                  Classes.on="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Accounts}" />
          <Button Classes="tab" Content="{StaticResource Settings_Tab_About}" Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static vm:SettingsTab.About}"
                  Classes.on="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=About}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer Margin="28,20,28,24" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <StackPanel Spacing="24" MaxWidth="640" HorizontalAlignment="Left"
                    IsVisible="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=General}">

          <!-- ── Apparence (thème + langue) ─────────────────────────────────────── -->
          <StackPanel Spacing="12">
            <TextBlock Text="{StaticResource Settings_AppearanceSectionTitle}" FontSize="{StaticResource FsCaption}"
                       FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="18" DataContext="{Binding General}" x:DataType="vm:SettingsGeneralViewModel">
                <StackPanel Spacing="10">
                  <TextBlock Text="{StaticResource Settings_ThemeLabel}" FontSize="{StaticResource FsBodySm}"
                             FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text1}" />
                  <StackPanel Orientation="Horizontal" Spacing="20">
                    <RadioButton GroupName="settingsTheme" Content="{StaticResource Settings_ThemeDark}"
                                 Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static settings:ThemePreference.Dark}"
                                 IsChecked="{Binding ThemeChoice, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Dark}" />
                    <RadioButton GroupName="settingsTheme" Content="{StaticResource Settings_ThemeLight}"
                                 Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static settings:ThemePreference.Light}"
                                 IsChecked="{Binding ThemeChoice, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Light}" />
                    <RadioButton GroupName="settingsTheme" Content="{StaticResource Settings_ThemeSystem}"
                                 Command="{Binding SelectThemeCommand}" CommandParameter="{x:Static settings:ThemePreference.System}"
                                 IsChecked="{Binding ThemeChoice, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=System}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{StaticResource Settings_LanguageLabel}" FontSize="{StaticResource FsBodySm}"
                             FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text1}" />
                  <ComboBox Width="200" HorizontalAlignment="Left" IsEnabled="{Binding IsLanguageEditable}"
                            SelectedIndex="0">
                    <ComboBoxItem Content="{Binding SelectedLanguageLabel}" />
                  </ComboBox>
                  <TextBlock Text="{StaticResource Settings_LanguageLockedHint}" FontSize="{StaticResource FsMicro}"
                             Foreground="{DynamicResource Text4}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ── VS Launcher (carte de la #31, inchangée) ───────────────────────── -->
          <StackPanel Spacing="12">
            <TextBlock Text="{StaticResource Settings_GeneralSectionTitle}" FontSize="{StaticResource FsCaption}"
                       FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />

            <Border Classes="card" Padding="20">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{StaticResource Settings_VslCardTitle}"
                               FontSize="{StaticResource FsBodySm}" FontWeight="{StaticResource FwMedium}"
                               Foreground="{DynamicResource Text1}" />
                    <TextBlock Text="{Binding VslStatusText}" TextWrapping="Wrap" MaxWidth="420"
                               FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}"
                               Foreground="{DynamicResource Text3}"
                               IsVisible="{Binding IsDetecting, Converter={x:Static BoolConverters.Not}}" />
                    <TextBlock Text="{StaticResource Settings_VslDetecting}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}"
                               IsVisible="{Binding IsDetecting}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="secondary" Command="{Binding PickFolderCommand}" Content="{StaticResource Settings_VslPickFolder}" />
                    <Button Command="{Binding OpenAdoptionCommand}" Content="{StaticResource Settings_VslOpenAdoption}"
                            IsVisible="{Binding VslDetected}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ── Premier lancement : passage possible, retour possible ──────────── -->
          <StackPanel Spacing="12">
            <TextBlock Text="{StaticResource Settings_FirstRunSectionTitle}" FontSize="{StaticResource FsCaption}"
                       FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
            <Border Classes="card" Padding="20">
              <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding ReplayFirstRunCommand}"
                      Content="{StaticResource Settings_ReplayFirstRun}" />
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- ── Jeu ───────────────────────────────────────────────────────────────── -->
        <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left"
                    IsVisible="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Game}">
          <StackPanel Spacing="12" DataContext="{Binding Game}" x:DataType="vm:SettingsGameViewModel">
            <TextBlock Text="{StaticResource Settings_GameSectionTitle}" FontSize="{StaticResource FsCaption}"
                       FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{StaticResource Settings_GameDataPathLabel}" FontSize="{StaticResource FsBodySm}"
                             FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text1}" />
                  <Border Background="{DynamicResource GlassItem}" BorderBrush="{DynamicResource GlassEdge}"
                          BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="12,8">
                    <SelectableTextBlock Text="{Binding DataPath}" FontFamily="{DynamicResource FontMono}"
                                         FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}"
                                         TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
                <Button Classes="secondary sm" HorizontalAlignment="Left" Command="{Binding OpenDataFolderCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.folder}"
                          Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                    <TextBlock Text="{StaticResource Settings_GameOpenFolder}" />
                  </StackPanel>
                </Button>
                <TextBlock Text="{StaticResource Settings_GameRelocateHint}" TextWrapping="Wrap"
                           FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- ── Réseau ────────────────────────────────────────────────────────────── -->
        <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left"
                    IsVisible="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Network}">
          <StackPanel Spacing="12" DataContext="{Binding Network}" x:DataType="vm:SettingsNetworkViewModel">
            <TextBlock Text="{StaticResource Settings_NetworkSectionTitle}" FontSize="{StaticResource FsCaption}"
                       FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="6">
                <TextBlock Text="{StaticResource Settings_NetworkConcurrencyLabel}" FontSize="{StaticResource FsBodySm}"
                           FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text1}" />
                <ComboBox Width="240" HorizontalAlignment="Left"
                          ItemsSource="{Binding AvailableConcurrencyChoices}"
                          SelectedItem="{Binding MaxParallelDownloads, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                      <TextBlock Text="{Binding Converter={x:Static conv:DownloadConcurrencyLabelConverter.Instance}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{StaticResource Settings_NetworkConcurrencyHint}" FontSize="{StaticResource FsMicro}"
                           Foreground="{DynamicResource Text4}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- ── Comptes ───────────────────────────────────────────────────────────────
             Trois états exclusifs portés par SettingsAccountsViewModel : formulaire, demande du
             code à six chiffres, état connecté. Le champ de mot de passe est masqué par
             PasswordChar (le ControlTheme TextBox le relaie déjà au presenter) et sa valeur ne
             quitte jamais le ViewModel, qui la vide dès la fin du flux. -->
        <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left"
                    IsVisible="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Accounts}">
          <TextBlock Text="{StaticResource Settings_AccountsSectionTitle}" FontSize="{StaticResource FsCaption}"
                     FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />

          <Border Classes="card" Padding="20" DataContext="{Binding Accounts}" x:DataType="vm:SettingsAccountsViewModel">
            <StackPanel Spacing="16">
              <TextBlock Text="{StaticResource Settings_AccountsIntro}" TextWrapping="Wrap" LineHeight="20"
                         FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text3}" />

              <!-- État déconnecté : identifiants -->
              <StackPanel Spacing="14">
                <StackPanel.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsSignedIn" Converter="{x:Static BoolConverters.Not}" />
                    <Binding Path="IsTwoFactorPending" Converter="{x:Static BoolConverters.Not}" />
                  </MultiBinding>
                </StackPanel.IsVisible>

                <StackPanel Spacing="6">
                  <TextBlock Text="{StaticResource Settings_AccountsEmailLabel}" FontSize="{StaticResource FsBodySm}"
                             FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text1}" />
                  <TextBox Text="{Binding Email, Mode=TwoWay}" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{StaticResource Settings_AccountsPasswordLabel}" FontSize="{StaticResource FsBodySm}"
                             FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text1}" />
                  <TextBox Text="{Binding Password, Mode=TwoWay}" PasswordChar="•" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                  <TextBlock Text="{StaticResource Settings_AccountsPasswordHint}" TextWrapping="Wrap" MaxWidth="420"
                             FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Button Content="{StaticResource Settings_AccountsSignIn}" Command="{Binding SignInCommand}" />
                  <TextBlock Text="{StaticResource Settings_AccountsSigningIn}" VerticalAlignment="Center"
                             FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}"
                             IsVisible="{Binding IsBusy}" />
                </StackPanel>
              </StackPanel>

              <!-- Deuxième passe : code à six chiffres -->
              <StackPanel Spacing="14" IsVisible="{Binding IsTwoFactorPending}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{StaticResource Settings_AccountsTwoFactorTitle}" FontSize="{StaticResource FsBodySm}"
                             FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text1}" />
                  <TextBlock Text="{StaticResource Settings_AccountsTwoFactorHint}" TextWrapping="Wrap" MaxWidth="420"
                             FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{StaticResource Settings_AccountsTwoFactorLabel}" FontSize="{StaticResource FsBodySm}"
                             FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text1}" />
                  <TextBox Text="{Binding TwoFactorCode, Mode=TwoWay}" MaxLength="6" MaxWidth="160" HorizontalAlignment="Left" Width="160"
                           FontFamily="{DynamicResource FontMono}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="{StaticResource Settings_AccountsTwoFactorSubmit}" Command="{Binding SubmitTwoFactorCommand}" />
                  <Button Classes="ghost" Content="{StaticResource Settings_AccountsTwoFactorCancel}" Command="{Binding CancelTwoFactorCommand}" />
                </StackPanel>
              </StackPanel>

              <!-- État connecté -->
              <StackPanel Spacing="14" IsVisible="{Binding IsSignedIn}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusMd}"
                          Background="{DynamicResource GlassItem}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1">
                    <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource Icon.user}"
                          Stroke="{DynamicResource Text2}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PlayerName}" TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource FsBodySm}" FontWeight="{StaticResource FwMedium}"
                               Foreground="{DynamicResource Text1}" />
                    <TextBlock Text="{Binding PlayerUid}" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}"
                               Foreground="{DynamicResource Text4}" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="secondary sm" VerticalAlignment="Center"
                          Content="{StaticResource Settings_AccountsSignOut}" Command="{Binding SignOutCommand}" />
                </Grid>
                <TextBlock Text="{StaticResource Settings_AccountsSignedInHint}" TextWrapping="Wrap"
                           FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
              </StackPanel>

              <!-- Échec de la dernière tentative, nommé par cas (voir UiText.Account) -->
              <Border Classes="alert danger" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" LineHeight="19"
                           FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource DangerText}" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ── À propos ──────────────────────────────────────────────────────────── -->
        <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left"
                    IsVisible="{Binding SelectedTab, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=About}">
          <StackPanel Spacing="12" DataContext="{Binding About}" x:DataType="vm:SettingsAboutViewModel">
            <Border Classes="card" Padding="20">
              <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                  <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource Accent}" />
                  <StackPanel Spacing="3">
                    <TextBlock Text="{StaticResource App_Title}" FontFamily="{DynamicResource FontDisplay}"
                               FontSize="{StaticResource FsHeading}" FontWeight="{StaticResource FwBold}"
                               Foreground="{DynamicResource Text1}" />
                    <TextBlock Text="{Binding AppVersion}" FontFamily="{DynamicResource FontMono}"
                               FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                  </StackPanel>
                </StackPanel>

                <TextBlock Text="{StaticResource Settings_AboutDescription}" TextWrapping="Wrap"
                           FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text2}" LineHeight="21" />

                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{StaticResource Settings_AboutLicenseLabel}" FontSize="{StaticResource FsCaption}"
                             Foreground="{DynamicResource Text4}" />
                  <TextBlock Text="{Binding License}" FontFamily="{DynamicResource FontMono}"
                             FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="secondary sm" HorizontalAlignment="Left" Command="{Binding OpenWebsiteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.external-link}"
                            Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                      <TextBlock Text="{StaticResource Settings_AboutWebsite}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="secondary sm" HorizontalAlignment="Left" Command="{Binding OpenGitHubCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.external-link}"
                            Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                      <TextBlock Text="{StaticResource Settings_AboutRepository}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>

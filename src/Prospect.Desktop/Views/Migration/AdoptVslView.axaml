<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Migration"
             xmlns:conv="using:Prospect.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="520"
             x:Class="Prospect.Desktop.Views.Migration.AdoptVslView"
             x:DataType="vm:AdoptVslViewModel">

  <!-- Un seul panneau qui traverse AdoptVslStep (voir AdoptVslViewModel) : sélection (cases à
       cocher, installations puis moteurs), progression par élément, rapport final groupé par
       catégorie. Un seul panneau qui traverse toutes les étapes, sans étape de chargement : la
       détection est déjà faite avant l'ouverture du dialogue. -->

  <Border Width="520" MaxHeight="680" CornerRadius="{StaticResource RadiusLg}" ClipToBounds="True"
          Background="{DynamicResource GlassDialog}" BorderBrush="{DynamicResource GlassEdge}"
          BorderThickness="1" BoxShadow="{DynamicResource GlassElevMenu}">
    <DockPanel>
      <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GlassEdge}" Padding="22,18">
        <StackPanel Spacing="4">
          <TextBlock Text="{StaticResource Dialog_AdoptVsl_Title}" TextWrapping="Wrap"
                     FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                     FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
          <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap"
                     FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource Text3}"
                     IsVisible="{Binding Step, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Selection}" />
        </StackPanel>
      </Border>

      <!-- ── Pied : sélection ─────────────────────────────────────────────────────── -->
      <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlassEdge}"
              Background="{DynamicResource GlassRowOdd}"
              IsVisible="{Binding Step, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Selection}">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="22,16">
          <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Left" Command="{Binding CancelSelectionCommand}"
                  Content="{StaticResource Dialog_AdoptVsl_Cancel}" />
          <Button Grid.Column="2" Command="{Binding ConfirmCommand}" Content="{StaticResource Dialog_AdoptVsl_Confirm}" />
        </Grid>
      </Border>

      <!-- ── Pied : progression ───────────────────────────────────────────────────── -->
      <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlassEdge}"
              Background="{DynamicResource GlassRowOdd}"
              IsVisible="{Binding Step, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Adopting}">
        <Grid ColumnDefinitions="*,Auto" Margin="22,16">
          <Button Grid.Column="1" Classes="ghost" Command="{Binding CancelAdoptionCommand}" Content="{StaticResource Dialog_AdoptVsl_CancelAdoption}" />
        </Grid>
      </Border>

      <!-- ── Pied : rapport ───────────────────────────────────────────────────────── -->
      <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlassEdge}"
              Background="{DynamicResource GlassRowOdd}"
              IsVisible="{Binding Step, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Report}">
        <Grid ColumnDefinitions="*,Auto" Margin="22,16">
          <Button Grid.Column="1" Command="{Binding CloseReportCommand}" Content="{StaticResource Dialog_AdoptVsl_Close}" />
        </Grid>
      </Border>

      <!-- Marge portée par le contenu, jamais par le Padding du ScrollViewer (voir la remarque
           mesuré large sinon, puis débordant). -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="22">

          <!-- ── Sélection ──────────────────────────────────────────────────────── -->
          <StackPanel Spacing="18" IsVisible="{Binding Step, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Selection}">

            <StackPanel Spacing="8" IsVisible="{Binding HasInstallations}">
              <TextBlock Text="{StaticResource Dialog_AdoptVsl_InstallationsSectionTitle}" FontSize="{StaticResource FsCaption}"
                         FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
              <Border Classes="card" Padding="0" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding InstallationRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VslInstallationSelectionRowViewModel">
                      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GlassEdge}" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*">
                          <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,10,0" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding VersionText}" FontFamily="{DynamicResource FontMono}"
                                         FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
                              <TextBlock Text="·" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                              <TextBlock Text="{Binding SizeText}" FontFamily="{DynamicResource FontMono}"
                                         FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
                              <TextBlock Text="·" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                              <TextBlock Text="{Binding ModCountText}" FontFamily="{DynamicResource FontMono}"
                                         FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasEngines}">
              <TextBlock Text="{StaticResource Dialog_AdoptVsl_EnginesSectionTitle}" FontSize="{StaticResource FsCaption}"
                         FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
              <Border Classes="alert info">
                <TextBlock Text="{StaticResource Dialog_AdoptVsl_EnginesNotice}" TextWrapping="Wrap" LineHeight="18"
                           FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}" />
              </Border>
              <Border Classes="card" Padding="0" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding EngineRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VslEngineSelectionRowViewModel">
                      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GlassEdge}" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <CheckBox Grid.Column="0" Margin="0,0,10,0" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding VersionText}" FontFamily="{DynamicResource FontMono}"
                                       FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
                            <TextBlock Text="·" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
                            <TextBlock Text="{Binding SizeText}" FontFamily="{DynamicResource FontMono}"
                                       FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
                          </StackPanel>
                          <ContentControl Grid.Column="2" Classes="badge stable" Content="{StaticResource Versions_InstalledBadge}"
                                           VerticalAlignment="Center" IsVisible="{Binding IsAlreadyInstalled}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

          </StackPanel>

          <!-- ── Progression ────────────────────────────────────────────────────── -->
          <StackPanel Spacing="12" IsVisible="{Binding Step, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Adopting}">
            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" IsIndeterminate="{Binding IsProgressIndeterminate}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding ProgressPhaseText}" TextTrimming="CharacterEllipsis"
                         FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text2}" />
              <TextBlock Grid.Column="1" Text="{Binding ProgressDetailText}" Margin="8,0,0,0"
                         FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}" />
            </Grid>
          </StackPanel>

          <!-- ── Rapport ────────────────────────────────────────────────────────── -->
          <StackPanel Spacing="14" IsVisible="{Binding Step, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Report}">
            <TextBlock Text="{Binding ReportSummaryText}" TextWrapping="Wrap" LineHeight="20"
                       FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />

            <ItemsControl ItemsSource="{Binding ReportGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AdoptionReportGroupViewModel">
                  <StackPanel Spacing="8" Margin="0,0,0,14">
                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsCaption}"
                               FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource Text2}" />
                    <Border Classes="card" Padding="0" ClipToBounds="True">
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AdoptionReportRowViewModel">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GlassEdge}" Padding="14,10">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                           FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text1}" />
                                <TextBlock Grid.Column="1" Text="{Binding DetailText}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}"
                                           Foreground="{DynamicResource Text4}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>

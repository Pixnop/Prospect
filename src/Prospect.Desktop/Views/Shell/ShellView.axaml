<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Shell"
             xmlns:dl="using:Prospect.Desktop.ViewModels.Downloads"
             xmlns:shell="using:Prospect.Desktop.Views.Shell"
             xmlns:conv="using:Prospect.Desktop.Converters"
             xmlns:layout="using:Prospect.Desktop.Layout"
             mc:Ignorable="d" d:DesignWidth="1160" d:DesignHeight="780"
             x:Class="Prospect.Desktop.Views.Shell.ShellView"
             x:DataType="vm:ShellViewModel">

  <!--
    Port de design/ui_kits/launcher/app-shell.jsx. Titlebar en bande pleine largeur (voir le
    commentaire d'en-tête de TitlebarView.axaml pour l'écart avec la maquette), sidebar 216px,
    zone de contenu résolue par le ViewLocator global. Popover Téléchargements, pile de toasts et
    panneau modal (wizard, dialogues de carte) sont des calques superposés au-dessus du contenu,
    dans cet ordre de déclaration (donc de z-order).
  -->

  <Panel>
    <Grid RowDefinitions="Auto,*">
      <shell:TitlebarView Grid.Row="0" IsVisible="{Binding UseCustomTitlebar}" />

      <Grid Grid.Row="1" ColumnDefinitions="216,*">

        <!-- Sidebar — profondeur « chrome » (30 %), la plus opaque des deux vitres de structure. -->
        <Border Grid.Column="0" Classes="glass chrome" BorderThickness="0,0,1,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="10,10,10,12" Spacing="2">
              <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlassEdge}" Margin="4,0,4,8" />
              <Button Classes="ghost navitem" Classes.active="{Binding IsDownloadsPopoverOpen}" Command="{Binding ToggleDownloadsPopoverCommand}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Path Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" Stretch="Uniform" Data="{StaticResource Icon.download}"
                        Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                  <TextBlock Grid.Column="1" Text="{StaticResource Nav_Telechargements}" VerticalAlignment="Center" />
                  <!-- Visible sur ce qui TOURNE, pas sur ce qui est affiché : depuis que le popover
                       garde l'historique de la session, une visibilité liée aux lignes laisserait
                       un « 0 » allumé longtemps après le dernier téléchargement. -->
                  <TextBlock Grid.Column="2" Text="{Binding Downloads.Count}" VerticalAlignment="Center"
                             FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}"
                             IsVisible="{Binding Downloads.HasActive}" />
                </Grid>
              </Button>
              <Button Classes="ghost navitem" Classes.active="{Binding LogsNavItem.IsActive}" Command="{Binding LogsNavItem.SelectCommand}">
                <Grid ColumnDefinitions="Auto,*">
                  <Path Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" Stretch="Uniform"
                        Data="{Binding LogsNavItem.IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                        Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                  <TextBlock Grid.Column="1" Text="{Binding LogsNavItem.Label}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Classes="ghost navitem" Classes.active="{Binding SettingsNavItem.IsActive}" Command="{Binding SettingsNavItem.SelectCommand}">
                <Grid ColumnDefinitions="Auto,*">
                  <Path Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" Stretch="Uniform"
                        Data="{Binding SettingsNavItem.IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                        Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                  <TextBlock Grid.Column="1" Text="{Binding SettingsNavItem.Label}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
              <TextBlock Text="{StaticResource Nav_Bibliotheque}" Margin="16,0,0,8"
                         FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsOverline}"
                         FontWeight="{StaticResource FwMedium}" LetterSpacing="1.1" Foreground="{DynamicResource Text3}" />
              <ItemsControl Margin="10,0" ItemsSource="{Binding LibraryNavItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavItemViewModel">
                    <Button Classes="ghost navitem" Classes.active="{Binding IsActive}" Command="{Binding SelectCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" Stretch="Uniform"
                              Data="{Binding IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                              Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text4}"
                                   IsVisible="{Binding Count, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Zone de contenu : la page courante se résout via le ViewLocator global. La vitre la
             plus fine du système (glass-pane, 15 %) l'enveloppe : elle pose un plancher de
             contraste sous les pages, qui n'ont elles-mêmes aucun fond propre. -->
        <Border Grid.Column="1" Background="{DynamicResource GlassPane}">
          <ContentControl Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>
      </Grid>
    </Grid>

    <!-- AllowsOverlap sur les trois calques ci-dessous : ils sont posés PAR-DESSUS la zone de
         contenu, c'est leur raison d'être. Le Panel les empile volontairement dans cet ordre de
         déclaration (donc de z-order) ; tout autre recouvrement dans ce shell reste un défaut. -->

    <!-- Popover Téléchargements : vue directe sur la file du DownloadManager
         (design/components/launcher/DownloadItem.jsx). La file garde ce qui est terminé, donc ce
         panneau est aussi l'historique de la session : chaque ligne finie porte son verdict, sa
         taille et son heure relative, et se retire à la croix. L'état vide reste affiché tant que
         rien n'a jamais été téléchargé. -->
    <Border IsVisible="{Binding IsDownloadsPopoverOpen}" Width="400" layout:LayoutContract.AllowsOverlap="True"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,20,0"
            CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
            Classes="glass menu">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,12">
          <TextBlock Grid.Column="0" Text="{StaticResource Downloads_Title}" VerticalAlignment="Center"
                     FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsOverline}"
                     FontWeight="{StaticResource FwMedium}" LetterSpacing="1.1" Foreground="{DynamicResource Text3}" />
          <Button Grid.Column="1" Classes="ghost sm" Margin="0,0,4,0"
                  Command="{Binding Downloads.ClearFinishedCommand}"
                  IsVisible="{Binding Downloads.HasFinished}"
                  Content="{StaticResource Downloads_ClearAll}" />
          <Button Grid.Column="2" Classes="icon sm" Command="{Binding CloseDownloadsPopoverCommand}" ToolTip.Tip="{StaticResource Downloads_Close}">
            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.x}"
                  Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          </Button>
        </Grid>

        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlassEdge}"
                IsVisible="{Binding Downloads.HasDownloads}">
          <StackPanel>
            <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Downloads.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="dl:DownloadItemViewModel">
                    <StackPanel Spacing="8" Margin="16,12">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Path Grid.Column="0" Width="15" Height="15" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center"
                              Data="{Binding IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                              Stroke="{DynamicResource Text3}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text1}" />
                        <TextBlock Grid.Column="2" Text="{Binding StatText}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
                        <!-- Une seule croix, deux gestes : annuler ce qui tourne, retirer ce qui est
                             fini. Le ViewModel choisit, l'infobulle suit. -->
                        <Button Grid.Column="3" Classes="icon sm" Margin="4,0,0,0" Command="{Binding DismissCommand}"
                                ToolTip.Tip="{StaticResource Downloads_Cancel}">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.x}"
                                Stroke="{DynamicResource Text3}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Button>
                      </Grid>
                      <StackPanel Spacing="4" IsVisible="{Binding !IsQueued}">
                        <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     IsVisible="{Binding IsActive}"
                                     Classes.danger="{Binding IsFailed}" />
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsActive}">
                          <TextBlock Grid.Column="0" Text="{Binding SpeedText}" TextTrimming="CharacterEllipsis"
                                     FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
                          <TextBlock Grid.Column="1" Text="{Binding PercentText}" Margin="8,0,0,0"
                                     FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
                        </Grid>
                        <!-- Ligne d'historique : verdict, puis la raison de l'échec le cas échéant,
                             puis l'heure relative. La barre et le débit n'ont plus rien à dire. -->
                        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsFinished}">
                          <ContentControl Grid.Column="0" Classes="badge" Content="{Binding OutcomeText}"
                                          VerticalAlignment="Center"
                                          Classes.stable="{Binding OutcomeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=stable}"
                                          Classes.incompatible="{Binding OutcomeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=incompatible}" />
                          <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" IsVisible="{Binding IsFailed}"
                                     FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource DangerText}" />
                          <TextBlock Grid.Column="2" Text="{Binding FinishedText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                     FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <!-- Ce pied compte ce qui tourne et ce qui attend : sur un popover qui n'a plus que de
                 l'historique, il n'a rien à dire et se retire au lieu de laisser une bande vide. -->
            <Border Classes="glassBand" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlassEdge}" Padding="16,10"
                    IsVisible="{Binding Downloads.SummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding Downloads.SummaryText}"
                         FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsMicro}" Foreground="{DynamicResource Text3}" />
            </Border>
          </StackPanel>
        </Border>

        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlassEdge}"
                IsVisible="{Binding !Downloads.HasDownloads}">
          <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="24,32">
            <Path Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" Data="{StaticResource Icon.download}"
                  Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round" />
            <TextBlock Text="{StaticResource Downloads_EmptyTitle}" HorizontalAlignment="Center"
                       FontSize="{StaticResource FsBodySm}" FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
            <TextBlock Text="{StaticResource Downloads_EmptyDescription}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" MaxWidth="260" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Pile de toasts. -->
    <ItemsControl ItemsSource="{Binding Toasts.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                  layout:LayoutContract.AllowsOverlap="True">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="12" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>

    <!-- Panneau modal partagé : wizard de création, dialogues de carte (renommer/dupliquer/supprimer). -->
    <Border Background="{DynamicResource BgScrim}" layout:LayoutContract.AllowsOverlap="True"
            IsVisible="{Binding Overlay.Active, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding Overlay.Active}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Panel>
</UserControl>

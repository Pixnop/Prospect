<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Home"
             xmlns:conv="using:Prospect.Desktop.Converters"
             xmlns:layout="using:Prospect.Desktop.Layout"
             mc:Ignorable="d" d:DesignWidth="212"
             x:Class="Prospect.Desktop.Views.Home.InstanceCardView"
             x:DataType="vm:InstanceCardViewModel">

  <!--
    Port de design/components/launcher/InstanceCard.jsx. Écart documenté par rapport à la
    maquette : la ligne meta n'affiche pas de nombre de mods (le domaine Mods n'existe pas encore,
    rien ne permet de le calculer aujourd'hui) — seule la dernière session humanisée reste.

    Ouverture de la page de détail : la vignette + le nom + la dernière session sont le CONTENU
    d'un Button "cardHit" sans le moindre chrome propre (Classes="cardHit", voir Button.axaml) —
    pas un calque transparent posé derrière eux. Un calque derrière ne fonctionne que là où rien
    d'autre ne couvre le pixel (Background=null laisse passer le clic, mais la vignette a un
    Background dégradé bien réel, donc opaque au clic) ; en faisant du bloc cliquable le contenu
    RÉEL du bouton, chaque pixel de cette zone déclenche vraiment OpenCommand. La rangée d'actions
    (Jouer/Arrêter + menu) reste un Grid ordinaire, frère du bouton plutôt qu'imbriqué dedans : un
    bouton dans un bouton capte correctement son propre clic sans le laisser remonter, mais autant
    ne pas en dépendre quand une structure plus simple donne la même garantie.

    DÉCOUVRABILITÉ. Le clic marchait, et personne ne le trouvait : un testeur a cherché comment
    ouvrir une instance sans imaginer que la vignette entière était le bouton. Le mécanisme n'a
    donc pas changé, c'est ce qu'il dit de lui-même qui a changé. La carte prend la classe
    `interactive` (curseur main, survol franc : voir Card.axaml) et porte un indice EXPLICITE, la
    pastille « Ouvrir » posée en coin de la bande d'art, invisible au repos et révélée au survol.
    Le contraste seul annonce qu'une surface réagit ; il n'annonce pas ce qu'elle fait. La même
    action ouvre le menu « … », en première entrée, pour qui n'essaie jamais de survoler.
  -->

  <Border Classes="card interactive" Width="212" Margin="0,0,20,20">
    <StackPanel>
      <Button Classes="cardHit" Command="{Binding OpenCommand}">
        <StackPanel>
          <Panel Height="96" ClipToBounds="True">
            <Panel.Background>
              <LinearGradientBrush StartPoint="30%,0%" EndPoint="70%,100%">
                <GradientStop Color="{StaticResource Copper900}" Offset="0" />
                <GradientStop Color="{StaticResource Stone850}" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
            <!-- Ce Border ne peint qu'un filet en bas de la bande, mais occupe toute sa surface :
                 il passe donc sous l'icône et sous le badge, par construction. -->
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GlassEdge}"
                    layout:LayoutContract.AllowsOverlap="True" />
            <Path Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="{Binding IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                  Stroke="{DynamicResource Text4}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            <!-- pinned : ce badge est posé sur la bande d'art, fixe dans les deux thèmes (voir le
                 commentaire de la variante "pinned" dans Badge.axaml) — son texte doit donc rester
                 lisible sur un fond qui ne bascule jamais en clair. -->
            <ContentControl Classes="badge pinned" Content="{Binding Version}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                            Classes.stable="{Binding ChannelBadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=stable}"
                            Classes.unstable="{Binding ChannelBadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=unstable}"
                            Classes.pre="{Binding ChannelBadgeTone, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=pre}" />
            <!-- Indice d'ouverture. Coin opposé au badge de version, donc sans concurrence même
                 avec un numéro de version long. Le chevauchement déclaré est celui du filet de
                 bande, qui occupe toute la surface du Panel par construction (voir plus haut) :
                 AllowsOverlap l'autorise pour cette pastille comme il l'autorise pour le badge. -->
            <Border Classes="openHint" layout:LayoutContract.AllowsOverlap="True"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
              <TextBlock Text="{StaticResource Card_Open}"
                         FontSize="{StaticResource FsCaption}" FontWeight="{StaticResource FwMedium}"
                         Foreground="{DynamicResource Text1}" />
            </Border>
          </Panel>

          <StackPanel Margin="16,16,16,0">
            <TextBlock Text="{Binding Name}"
                       FontSize="{StaticResource FsSubheading}" FontWeight="{StaticResource FwSemibold}"
                       Foreground="{DynamicResource Text1}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding LastPlayedText}" Margin="0,4,0,0"
                       FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource Text3}" />
            <!-- Pastille discrète : dernier résultat connu d'une vérification de mises à jour
                 (feature 4b), invalidé par toute modification des mods. Pas de vérification
                 automatique au démarrage en MVP, donc absente tant qu'aucune vérification
                 explicite n'a eu lieu cette session (voir IModUpdateCheckCache). -->
            <ContentControl Classes="badge unstable" Content="{Binding UpdatesBadgeText}"
                            Margin="0,6,0,0" HorizontalAlignment="Left" IsVisible="{Binding HasUpdates}" />
          </StackPanel>
        </StackPanel>
      </Button>

      <Grid ColumnDefinitions="*,Auto" Margin="16,14,16,16">
        <Button Grid.Column="0" IsVisible="{Binding !IsRunning}" Command="{Binding PlayCommand}" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.play}"
                  Stroke="{DynamicResource TextOnAccent}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                  IsVisible="{Binding !IsLaunching}" />
            <TextBlock Text="{StaticResource Card_Play}" IsVisible="{Binding !IsLaunching}" />
            <TextBlock Text="{StaticResource Card_Launching}" IsVisible="{Binding IsLaunching}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="0" Classes="secondary" IsVisible="{Binding IsRunning}"
                Command="{Binding RequestStopCommand}" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource Icon.square}"
                  Stroke="{DynamicResource Text1}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            <TextBlock Text="{StaticResource Card_Stop}" />
          </StackPanel>
        </Button>

        <Button Grid.Column="1" Classes="icon bordered" Margin="8,0,0,0" ToolTip.Tip="{StaticResource Card_Actions}">
          <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource Icon.more}"
                Stroke="{DynamicResource Text2}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          <Button.Flyout>
            <MenuFlyout Placement="Bottom">
              <!-- « Ouvrir » d'abord : c'est l'action principale de la carte, et le seul chemin
                   vers la page de détail pour qui n'a pas découvert la vignette cliquable. -->
              <MenuItem Header="{StaticResource Card_Open}" Command="{Binding OpenCommand}" />
              <MenuItem Header="{StaticResource Card_Rename}" Command="{Binding RenameCommand}" />
              <MenuItem Header="{StaticResource Card_Duplicate}" Command="{Binding DuplicateCommand}" />
              <MenuItem Header="{StaticResource Card_Delete}" Command="{Binding DeleteCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prospect.Desktop.ViewModels.Home"
             mc:Ignorable="d" d:DesignWidth="944" d:DesignHeight="700"
             x:Class="Prospect.Desktop.Views.Home.HomeView"
             x:DataType="vm:HomeViewModel">

  <!-- Port de design/ui_kits/launcher/screen-home.jsx : PageHeader (titre + sous-titre + action),
       toolbar recherche/tri, grille (voir GridItems côté ViewModel pour la tuile "nouvelle
       instance"), états vides, zone discrète des instances cassées. -->

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="28,24,28,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="{StaticResource Home_Title}"
                     FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsTitle}"
                     FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
          <TextBlock Text="{Binding SubtitleText}" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text3}"
                     IsVisible="{Binding SubtitleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="lg" Command="{Binding NewInstanceCommand}" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource Icon.plus}"
                  Stroke="{DynamicResource TextOnAccent}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            <TextBlock Text="{StaticResource Home_NewInstance}" />
          </StackPanel>
        </Button>
      </Grid>

      <StackPanel Orientation="Horizontal" Margin="0,20,0,0" Spacing="10">
        <TextBox Width="260" Watermark="{StaticResource Home_SearchPlaceholder}" Text="{Binding SearchText, Mode=TwoWay}">
          <TextBox.InnerLeftContent>
            <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource Icon.search}"
                  Stroke="{DynamicResource Text3}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="icon sm" Command="{Binding ClearSearchCommand}"
                    IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icon.x}"
                    Stroke="{DynamicResource Text3}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>

        <ComboBox Width="180" SelectedIndex="{Binding SortModeIndex, Mode=TwoWay}">
          <ComboBoxItem Content="{StaticResource Home_SortLastLaunched}" />
          <ComboBoxItem Content="{StaticResource Home_SortName}" />
        </ComboBox>
      </StackPanel>
    </StackPanel>

    <ScrollViewer Padding="28,20,28,28">
      <StackPanel Spacing="28">

        <Border CornerRadius="{StaticResource RadiusMd}" BorderThickness="1" Background="Transparent"
                BorderBrush="{DynamicResource BorderDefault}" IsVisible="{Binding HasNoInstancesAtAll}">
          <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="32,48" MaxWidth="400">
            <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Data="{StaticResource Icon.layers}"
                  Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round" />
            <TextBlock Text="{StaticResource Home_EmptyTitle}" HorizontalAlignment="Center"
                       FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                       FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
            <TextBlock Text="{StaticResource Home_EmptyDescription}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text3}" LineHeight="20" />
            <Button Command="{Binding NewInstanceCommand}" HorizontalAlignment="Center" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource Icon.plus}"
                      Stroke="{DynamicResource TextOnAccent}" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" />
                <TextBlock Text="{StaticResource Home_NewInstance}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <Border CornerRadius="{StaticResource RadiusMd}" BorderThickness="1" Background="Transparent"
                BorderBrush="{DynamicResource BorderDefault}" IsVisible="{Binding ShowSearchEmptyState}">
          <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="32,48" MaxWidth="400">
            <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Data="{StaticResource Icon.layers}"
                  Stroke="{DynamicResource Text4}" StrokeThickness="1.25" StrokeLineCap="Round" StrokeJoin="Round" />
            <TextBlock Text="{StaticResource Home_NoResultsTitle}" HorizontalAlignment="Center"
                       FontFamily="{DynamicResource FontDisplay}" FontSize="{StaticResource FsHeading}"
                       FontWeight="{StaticResource FwSemibold}" Foreground="{DynamicResource Text1}" />
            <TextBlock Text="{Binding NoResultsDescription}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" FontSize="{StaticResource FsBodySm}" Foreground="{DynamicResource Text3}" LineHeight="20" />
            <Button Classes="secondary" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Center"
                    Margin="0,4,0,0" Content="{StaticResource Home_ClearFilter}" />
          </StackPanel>
        </Border>

        <!-- Pas d'ItemTemplate explicite : chaque élément (InstanceCardViewModel ou
             NewInstanceTileViewModel) se résout via le ViewLocator global. La gouttière de 20px
             (token gutter du design) est portée par la marge du contrôle racine de chaque vue
             plutôt que par le conteneur généré, WrapPanel n'exposant pas d'espacement inter-éléments. -->
        <ItemsControl ItemsSource="{Binding GridItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <StackPanel IsVisible="{Binding HasBrokenInstances}" Spacing="8">
          <TextBlock Text="{StaticResource Home_BrokenSectionTitle}"
                     FontFamily="{DynamicResource FontMono}" FontSize="{StaticResource FsOverline}"
                     FontWeight="{StaticResource FwMedium}" LetterSpacing="1.1" Foreground="{DynamicResource Text3}" />
          <ItemsControl ItemsSource="{Binding BrokenInstances}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BrokenInstanceRowViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                  <TextBlock Text="{Binding FolderName}" FontFamily="{DynamicResource FontMono}"
                             FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text2}" />
                  <TextBlock Text="—" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text4}" />
                  <TextBlock Text="{Binding Reason}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Text3}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
